@page
@model Essco.Web.Pages.Companies.ProfileModel
@using Essco.Domain.Companies
@{ ViewData["Title"] = "Empresa"; }
<h1>Empresa</h1>
<p class="text-muted">Datos fiscales, comerciales y parámetros operativos.</p>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert alert-success">@Model.StatusMessage</div> }
<div class="alert alert-info" role="note">Este módulo continúa en migración. Las credenciales de correo, FTP y SQL/SAP no se muestran ni modifican desde esta página.</div>
<!-- Navegación equivalente a las dos pestañas principales de WinForms. -->
<ul class="nav nav-tabs mb-4" id="companyTabs" role="tablist">
 <li class="nav-item" role="presentation"><button class="nav-link active" id="company-general-tab" data-bs-toggle="tab" data-bs-target="#company-general-pane" type="button" role="tab" aria-controls="company-general-pane" aria-selected="true">Empresa</button></li>
 <li class="nav-item" role="presentation"><button class="nav-link" id="company-settings-tab" data-bs-toggle="tab" data-bs-target="#company-settings-pane" type="button" role="tab" aria-controls="company-settings-pane" aria-selected="false">Configuraciones</button></li>
</ul>
<form method="post">
 <div asp-validation-summary="All" class="text-danger"></div>
 <div class="tab-content" id="companyTabContent">
 <!-- Datos generales de la empresa. -->
 <section class="tab-pane fade show active" id="company-general-pane" role="tabpanel" aria-labelledby="company-general-tab" tabindex="0">
 <div class="row g-3">
  <div class="col-md-3"><label asp-for="Input.IdentificationType" class="form-label"></label><select asp-for="Input.IdentificationType" asp-items="Html.GetEnumSelectList<CompanyIdentificationType>()" class="form-select"></select></div>
  <div class="col-md-3"><label asp-for="Input.TaxId" class="form-label"></label><input asp-for="Input.TaxId" class="form-control" /></div>
  <div class="col-md-6"><label asp-for="Input.LegalName" class="form-label"></label><input asp-for="Input.LegalName" class="form-control" /></div>
  <div class="col-md-6"><label asp-for="Input.TradeName" class="form-label"></label><input asp-for="Input.TradeName" class="form-control" /></div>
  <div class="col-md-3"><label asp-for="Input.Phone" class="form-label"></label><input asp-for="Input.Phone" class="form-control" /></div>
  <div class="col-md-3"><label asp-for="Input.SecondaryPhone" class="form-label"></label><input asp-for="Input.SecondaryPhone" class="form-control" /></div>
  <div class="col-md-6"><label asp-for="Input.Email" class="form-label"></label><input asp-for="Input.Email" class="form-control" /></div>
  <div class="col-md-6"><label asp-for="Input.Website" class="form-label"></label><input asp-for="Input.Website" class="form-control" /></div>
  <div class="col-md-3"><label asp-for="Input.ProvinceId" class="form-label"></label><select asp-for="Input.ProvinceId" asp-items="Model.Provinces" class="form-select"><option value="">Seleccione</option></select></div>
  <div class="col-md-3"><label asp-for="Input.CantonId" class="form-label"></label><select asp-for="Input.CantonId" asp-items="Model.Cantons" class="form-select"><option value="">Seleccione</option></select></div>
  <div class="col-md-3"><label asp-for="Input.DistrictId" class="form-label"></label><select asp-for="Input.DistrictId" asp-items="Model.Districts" class="form-select"><option value="">Seleccione</option></select></div>
  <div class="col-md-3"><label asp-for="Input.NeighborhoodId" class="form-label"></label><select asp-for="Input.NeighborhoodId" asp-items="Model.Neighborhoods" class="form-select"><option value="">Seleccione</option></select></div>
  <div class="col-12"><label asp-for="Input.Address" class="form-label"></label><textarea asp-for="Input.Address" class="form-control" rows="3"></textarea></div>
  <div class="col-md-3"><label asp-for="Input.EconomicActivityCode" class="form-label"></label><input asp-for="Input.EconomicActivityCode" class="form-control" /></div>
  <div class="col-md-9"><label asp-for="Input.EconomicActivityDescription" class="form-label"></label><input asp-for="Input.EconomicActivityDescription" class="form-control" /></div>
 </div>
 </section>
 <!-- Parámetros operativos sin secretos. -->
 <section class="tab-pane fade" id="company-settings-pane" role="tabpanel" aria-labelledby="company-settings-tab" tabindex="0">
 <h2 class="h4">Configuraciones operativas</h2>
 <p class="text-muted">Estos parámetros se guardan junto con los datos generales.</p>
 <div class="row g-3">
  <div class="col-md-3"><label asp-for="Input.MaximumInvoiceLines" class="form-label"></label><input asp-for="Input.MaximumInvoiceLines" class="form-control" /></div>
  <div class="col-md-3"><label asp-for="Input.MaximumDiscountPercent" class="form-label"></label><input asp-for="Input.MaximumDiscountPercent" class="form-control" /></div>
  <div class="col-md-3"><label asp-for="Input.ExtensionDays" class="form-label"></label><input asp-for="Input.ExtensionDays" class="form-control" /></div>
  <div class="col-md-3"><label asp-for="Input.DiscountGrouping" class="form-label"></label><select asp-for="Input.DiscountGrouping" asp-items="Html.GetEnumSelectList<DiscountGroupingType>()" class="form-select"></select></div>
  <div class="col-md-6"><label asp-for="Input.LoadReportSequence" class="form-label"></label><input asp-for="Input.LoadReportSequence" class="form-control" /></div>
  <div class="col-md-6"><label asp-for="Input.ReturnReportSequence" class="form-label"></label><input asp-for="Input.ReturnReportSequence" class="form-control" /></div>
 </div>
 <div class="card mt-4"><div class="card-body">
  <h3 class="h5">Razones de no visita</h3>
  <p>Consulta, agrega y edita razones desde el catálogo operativo existente.</p>
  <a asp-page="/Catalogs/NoVisitReasons" class="btn btn-outline-primary">Abrir razones de no visita</a>
 </div></div>
 <div class="alert alert-secondary mt-4" role="note">Pendiente: administración segura de la contraseña de correo y la conexión FTP y SQL/SAP. Guardar esta página no modifica los valores existentes de esos campos.</div>
 </section>
 </div>
 <button type="submit" class="btn btn-primary mt-4">Guardar empresa</button>
</form>
@section Scripts {
 <partial name="_ValidationScriptsPartial" />
 <script>
 const province=document.getElementById('Input_ProvinceId'), canton=document.getElementById('Input_CantonId'), district=document.getElementById('Input_DistrictId'), neighborhood=document.getElementById('Input_NeighborhoodId');
 async function fill(select,url){select.innerHTML='<option value="">Seleccione</option>';if(!url)return;const response=await fetch(url,{headers:{Accept:'application/json'}});if(!response.ok)return;for(const item of await response.json())select.add(new Option(item.name,item.id));}
 province.addEventListener('change',async()=>{await fill(canton,province.value?`?handler=Cantons&provinceId=${province.value}`:null);await fill(district);await fill(neighborhood);});
 canton.addEventListener('change',async()=>{await fill(district,canton.value?`?handler=Districts&provinceId=${province.value}&cantonId=${canton.value}`:null);await fill(neighborhood);});
 district.addEventListener('change',()=>fill(neighborhood,district.value?`?handler=Neighborhoods&provinceId=${province.value}&cantonId=${canton.value}&districtId=${district.value}`:null));
 </script>
}
