@page
@model Essco.Web.Pages.Liquidations.SummaryModel
@{ViewData["Title"]="Resumen de liquidación";}
<div class="d-print-none mb-3"><a asp-page="Index">← Liquidaciones</a> <button type="button" class="btn btn-outline-primary ms-2" onclick="window.print()">Imprimir / Guardar PDF</button></div>
<article class="liquidation-report">
 <header class="report-header"><div><div class="report-brand">ESSCO</div><small>Easy Software Solution Company</small></div><div class="text-end"><strong>LIQUIDACIÓN</strong><br/>N.º @Model.Liquidation.Consecutive</div></header>
 <div class="report-title"><h1>Resumen de liquidación</h1><span class="badge text-bg-@(Model.Liquidation.IsAnnulled?"danger":"primary")">@(Model.Liquidation.IsAnnulled?"ANULADA":"ACTIVA")</span></div>
 <dl class="report-details"><div><dt>Responsable</dt><dd>@Model.Liquidation.EmployeeCode — @Model.Liquidation.EmployeeName</dd></div><div><dt>Identificación</dt><dd>@Model.Liquidation.Identification</dd></div><div><dt>Clase / tipo</dt><dd>@Model.Liquidation.Kind / @Model.Liquidation.Type</dd></div><div><dt>Fecha</dt><dd>@Model.Liquidation.Date</dd></div><div><dt>Período</dt><dd>@Model.Liquidation.From — @Model.Liquidation.To</dd></div><div><dt>Ruta</dt><dd>@Model.Liquidation.Route</dd></div></dl>
 @if(Model.StatusMessage is not null){<div class="alert alert-info d-print-none">@Model.StatusMessage</div>}
 <table class="table report-table"><thead><tr><th>Concepto</th><th class="text-end">Monto</th></tr></thead><tbody><tr><td>Facturas conciliadas (informativo)</td><td class="text-end">@Model.Summary.Invoices.ToString("N2")</td></tr><tr><td>Depósitos</td><td class="text-end">@Model.Summary.Deposits.ToString("N2")</td></tr><tr><td>Recibos SAP</td><td class="text-end">@Model.Summary.Receipts.ToString("N2")</td></tr><tr><td>Gastos incluidos</td><td class="text-end">@Model.Summary.Expenses.ToString("N2")</td></tr></tbody><tfoot><tr><th>Diferencia (depósitos + gastos − recibos)</th><th class="text-end">@Model.Summary.Result.ToString("N2")</th></tr></tfoot></table>
 @if(!string.IsNullOrWhiteSpace(Model.Liquidation.Notes)){<section class="report-notes"><strong>Comentarios</strong><p>@Model.Liquidation.Notes</p></section>}
 <footer class="report-footer">ESSCO · Un mundo con menos clic. · Documento generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</footer>
</article>
@if(!Model.Liquidation.IsAnnulled){<form method="post" asp-page-handler="Recalculate" class="mt-3 d-print-none"><input type="hidden" name="kind" value="@Model.Liquidation.Kind"/><input type="hidden" name="number" value="@Model.Liquidation.Consecutive"/><button class="btn btn-primary">Guardar resultado recalculado</button></form>}
