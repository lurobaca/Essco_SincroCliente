@page
@model Essco.Web.Pages.Liquidations.SummaryModel
@{ViewData["Title"]="Resumen de liquidación";}<p><a asp-page="Index">← Liquidaciones</a></p><h1>Liquidación @Model.Liquidation.Consecutive</h1><p>@Model.Liquidation.EmployeeCode - @Model.Liquidation.EmployeeName · @Model.Liquidation.From — @Model.Liquidation.To</p>@if(Model.StatusMessage is not null){<div class="alert alert-info">@Model.StatusMessage</div>}<div class="row g-3"><div class="col"><div class="card card-body"><strong>Facturas</strong>@Model.Summary.Invoices.ToString("N2")</div></div><div class="col"><div class="card card-body"><strong>Depósitos</strong>@Model.Summary.Deposits.ToString("N2")</div></div><div class="col"><div class="card card-body"><strong>Recibos</strong>@Model.Summary.Receipts.ToString("N2")</div></div><div class="col"><div class="card card-body"><strong>Gastos</strong>@Model.Summary.Expenses.ToString("N2")</div></div><div class="col"><div class="card card-body"><strong>Diferencia</strong>@Model.Summary.Result.ToString("N2")</div></div></div>@if(!Model.Liquidation.IsAnnulled){<form method="post" asp-page-handler="Recalculate" class="mt-3"><input type="hidden" name="kind" value="@Model.Liquidation.Kind"/><input type="hidden" name="number" value="@Model.Liquidation.Consecutive"/><button class="btn btn-primary">Guardar resultado recalculado</button></form>}
