@page
@model Essco.Web.Pages.Liquidations.IndexModel
@using Essco.Domain.Liquidations
@{ViewData["Title"]="Liquidaciones";}
<h1>Liquidaciones</h1><p><a asp-page="Expenses">Administrar gastos</a></p>@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="alert alert-info">@Model.StatusMessage</div>}
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col"><label>Clase</label><select asp-for="Filter.Kind" asp-items="Html.GetEnumSelectList<LiquidationKind>()" class="form-select"></select></div><div class="col"><label>Desde</label><input asp-for="Filter.From" class="form-control"/></div><div class="col"><label>Hasta</label><input asp-for="Filter.To" class="form-control"/></div><div class="col"><label>Consecutivo</label><input asp-for="Filter.Consecutive" class="form-control"/></div></div><label class="form-check mt-2"><input asp-for="Filter.IncludeAnnulled" class="form-check-input"/> Incluir anuladas</label><div><button class="btn btn-outline-primary">Buscar</button> <a asp-page="Index" class="btn btn-outline-secondary">Limpiar</a></div></form>
<form method="post" asp-page-handler="Save" class="card card-body mb-3"><input asp-for="Input.IsNew" type="hidden"/><input asp-for="Input.Consecutive" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="row g-2"><div class="col"><label>Clase</label><select asp-for="Input.Kind" asp-items="Html.GetEnumSelectList<LiquidationKind>()" class="form-select"></select></div><div class="col"><label>Código</label><input asp-for="Input.EmployeeCode" class="form-control"/></div><div class="col"><label>Cédula</label><input asp-for="Input.Identification" class="form-control"/></div><div class="col"><label>Nombre</label><input asp-for="Input.EmployeeName" class="form-control"/></div><div class="col"><label>Fecha</label><input asp-for="Input.Date" class="form-control"/></div></div><div class="row g-2 mt-1"><div class="col"><label>Desde</label><input asp-for="Input.From" class="form-control"/></div><div class="col"><label>Hasta</label><input asp-for="Input.To" class="form-control"/></div><div class="col"><label>Tipo</label><input asp-for="Input.Type" class="form-control"/></div><div class="col"><label>Ruta</label><input asp-for="Input.Route" class="form-control"/></div><div class="col"><label>Resultado</label><input asp-for="Input.Result" class="form-control"/></div></div><div class="row g-2 mt-1"><div class="col"><label>Recibos desde</label><input asp-for="Input.ReceiptFrom" class="form-control"/></div><div class="col"><label>Recibos hasta</label><input asp-for="Input.ReceiptTo" class="form-control"/></div><div class="col"><label>Agentes</label><input asp-for="Input.AgentCodes" class="form-control"/></div><div class="col"><label>Reportes facturas</label><input asp-for="Input.InvoiceReportCodes" class="form-control"/></div></div><label class="mt-2">Comentarios</label><textarea asp-for="Input.Notes" class="form-control"></textarea><div class="mt-2"><button class="btn btn-primary">Guardar</button> <a asp-page="Index" asp-route-Filter.Kind="@Model.Filter.Kind" class="btn btn-outline-secondary">Nuevo</a></div></form>
<table class="table table-striped"><thead><tr><th>#</th><th>Fecha</th><th>Empleado</th><th>Rango</th><th>Ruta</th><th class="text-end">Resultado</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr class="@(x.IsAnnulled?"table-danger":"")"><td>@x.Consecutive</td><td>@x.Date</td><td>@x.EmployeeCode - @x.EmployeeName</td><td>@x.From — @x.To</td><td>@x.Route</td><td class="text-end">@x.Result.ToString("N2")</td><td>@(x.IsAnnulled?"Anulada":"Activa")</td><td><a asp-route-Filter.Kind="@Model.Filter.Kind" asp-route-edit="@x.Consecutive" class="btn btn-sm btn-outline-secondary">Editar</a>@if(!x.IsAnnulled){<form method="post" asp-page-handler="Annul" class="d-inline"><input type="hidden" name="consecutive" value="@x.Consecutive"/><input type="hidden" name="type" value="@x.Type"/><input type="hidden" name="Filter.Kind" value="@Model.Filter.Kind"/><button class="btn btn-sm btn-outline-danger">Anular</button></form>}</td></tr>}</tbody></table>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
