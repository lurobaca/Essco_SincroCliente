@page
@model Essco.Web.Pages.Liquidations.ExpensesModel
@{ViewData["Title"]="Gastos";}<h1>Gastos de liquidación</h1><p><a asp-page="Index">Volver a liquidaciones</a></p>@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="alert alert-info">@Model.StatusMessage</div>}
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col"><input asp-for="Filter.Type" placeholder="AGENTES/CHOFERES" class="form-control"/></div><div class="col"><input asp-for="Filter.Liquidation" placeholder="Liquidación" class="form-control"/></div><div class="col"><input asp-for="Filter.Employee" placeholder="Empleado" class="form-control"/></div><div class="col"><input asp-for="Filter.From" class="form-control"/></div><div class="col"><input asp-for="Filter.To" class="form-control"/></div></div><label class="form-check"><input asp-for="Filter.IncludeAnnulled" class="form-check-input"/> Incluir anulados</label><button class="btn btn-outline-primary">Buscar</button></form>
<form method="post" asp-page-handler="Save" class="card card-body mb-3"><input asp-for="Input.IsNew" type="hidden"/><input asp-for="Input.Id" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="row g-2"><div class="col"><input asp-for="Input.DocumentNumber" placeholder="Documento" class="form-control"/></div><div class="col"><input asp-for="Input.Category" placeholder="Categoría" class="form-control"/></div><div class="col"><input asp-for="Input.Amount" placeholder="Monto" class="form-control"/></div><div class="col"><input asp-for="Input.EmployeeCode" placeholder="Empleado" class="form-control"/></div><div class="col"><select asp-for="Input.LiquidationType" class="form-select"><option>AGENTES</option><option>CHOFERES</option></select></div><div class="col"><input asp-for="Input.LiquidationNumber" placeholder="Liquidación" class="form-control"/></div></div><div class="row g-2 mt-1"><div class="col"><input asp-for="Input.Date" class="form-control"/></div><div class="col"><input asp-for="Input.SupplierCode" placeholder="Proveedor" class="form-control"/></div><div class="col"><input asp-for="Input.Description" placeholder="Descripción" class="form-control"/></div></div><label class="form-check"><input asp-for="Input.IsElectronicInvoice" class="form-check-input"/> Factura electrónica</label><label class="form-check"><input asp-for="Input.IncludeInLiquidation" class="form-check-input"/> Incluir en liquidación</label><button class="btn btn-primary">Guardar</button></form>
<table class="table table-striped"><thead><tr><th>#</th><th>Documento</th><th>Fecha</th><th>Tipo</th><th>Empleado</th><th>Liquidación</th><th class="text-end">Monto</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr class="@(x.IsAnnulled?"table-danger":"")"><td>@x.Id</td><td>@x.DocumentNumber</td><td>@x.Date</td><td>@x.Category</td><td>@x.EmployeeCode</td><td>@x.LiquidationType @x.LiquidationNumber</td><td class="text-end">@x.Amount.ToString("N2")</td><td><a asp-route-edit="@x.Id" class="btn btn-sm btn-outline-secondary">Editar</a>@if(!x.IsAnnulled){<form method="post" asp-page-handler="Annul" class="d-inline"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-danger">Anular</button></form>}</td></tr>}</tbody></table>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
