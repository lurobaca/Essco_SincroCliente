@page
@model Essco.Web.Pages.Purchasing.IndexModel
@{ViewData["Title"]="Pedidos";}<h1>Pedidos a proveedores</h1>@if(Model.StatusMessage is not null){<div class="alert alert-info">@Model.StatusMessage</div>}<form method="get" class="row g-2 mb-3"><div class="col"><input asp-for="Number" placeholder="Número" class="form-control"/></div><div class="col"><input asp-for="Supplier" placeholder="Proveedor" class="form-control"/></div><div class="col"><input asp-for="From" type="date" class="form-control"/></div><div class="col"><input asp-for="To" type="date" class="form-control"/></div><div class="col"><select asp-for="State" class="form-select"><option value="pending">Pendientes SAP</option><option value="sent">Enviados SAP</option><option value="all">Todos</option></select></div><div class="col-auto"><button class="btn btn-primary">Buscar</button></div></form><table class="table table-striped"><thead><tr><th>Número</th><th>Fecha</th><th>Proveedor</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><a asp-page="Detail" asp-route-number="@x.Number">@x.Number</a></td><td>@x.Date</td><td>@x.SupplierCode - @x.SupplierName</td><td>@(x.CreatedInSap?"SAP":x.Closed?"Cerrado":"Pendiente")</td><td>@if(!x.CreatedInSap&&!x.Closed){<form method="post" asp-page-handler="Dispatch" class="d-inline"><input type="hidden" name="number" value="@x.Number"/><button class="btn btn-sm btn-success">Enviar a SAP</button></form><form method="post" asp-page-handler="Cancel" class="d-inline"><input type="hidden" name="number" value="@x.Number"/><button class="btn btn-sm btn-outline-danger">Anular</button></form>}</td></tr>}</tbody></table>
