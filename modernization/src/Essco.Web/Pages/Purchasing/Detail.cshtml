@page "{number:int}"
@model Essco.Web.Pages.Purchasing.DetailModel
@{ViewData["Title"]="Detalle de pedido";}<p><a asp-page="Index">← Pedidos</a></p><h1>Pedido @Model.Order!.Number</h1><p>@Model.Order.SupplierCode - @Model.Order.SupplierName · @Model.Order.Date</p>@if(Model.StatusMessage is not null){<div class="alert alert-info">@Model.StatusMessage</div>}@if(Model.Input.Id>0){<form method="post" asp-page-handler="Save" class="card card-body mb-3"><input asp-for="Input.Id" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="row g-2"><div class="col"><label>Unidades</label><input asp-for="Input.Units" class="form-control"/></div><div class="col"><label>Cajas</label><input asp-for="Input.Cases" class="form-control"/></div><div class="col"><label>Total</label><input asp-for="Input.Total" class="form-control"/></div><div class="col"><label>Motivo</label><input asp-for="Input.Reason" class="form-control"/></div><div class="col-auto align-self-end"><button class="btn btn-primary">Guardar</button></div></div></form>}<table class="table"><thead><tr><th>Artículo</th><th>Costo</th><th>Empaque</th><th>Unidades</th><th>Cajas</th><th>Total</th><th></th></tr></thead><tbody>@foreach(var x in Model.Order.Lines){<tr><td>@x.ItemCode - @x.Description</td><td>@x.Cost.ToString("N2")</td><td>@x.Pack</td><td>@x.Units</td><td>@x.Cases</td><td>@x.Total.ToString("N2")</td><td>@if(!Model.Order.Closed&&!Model.Order.CreatedInSap){<a asp-route-number="@Model.Order.Number" asp-route-edit="@x.Id" class="btn btn-sm btn-outline-secondary">Editar</a>}</td></tr>}</tbody><tfoot><tr><th colspan="5">Total</th><th>@Model.Order.Total.ToString("N2")</th><th></th></tr></tfoot></table>
