@page
@model Essco.Web.Pages.Billing.TransmissionStatusModel
@{
    ViewData["Title"] = "Estado de transmisiones";
}

<h1>Estado de transmisiones</h1>
<p>Consulta de los resultados registrados por Syncro Cliente al transmitir archivos hacia SAP.</p>

@if (Model.Notice is not null)
{
    <div class="alert alert-info" role="status">@Model.Notice</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <strong>Agente en secuencia</strong>
            <p class="mb-0">@(Model.ActiveAgent ?? "Sin información")</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <strong>Proceso actual</strong>
            <p class="mb-0">@(Model.CurrentProcess ?? "Sin información")</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <strong>Origen de descarga</strong>
            <p>@(Model.DownloadFromFtp is null ? "Sin información" : Model.DownloadFromFtp.Value ? "FTP" : "Local")</p>
            @if (Model.CanManage && Model.DownloadFromFtp is not null)
            {
                <form method="post" asp-page-handler="Source">
                    <input type="hidden" name="downloadFromFtp" value="@(!Model.DownloadFromFtp.Value)" />
                    <button class="btn btn-outline-primary" type="submit">Cambiar a @(Model.DownloadFromFtp.Value ? "local" : "FTP")</button>
                </form>
            }
        </div>
    </div>
</div>

@foreach (var alert in Model.FtpAlerts)
{
    <div class="alert alert-warning" role="alert">@alert</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <label asp-for="FileType" class="form-label">Archivo</label>
        <select asp-for="FileType" class="form-select">
            <option>Todos</option>
            <option>Pedidos</option>
            <option>Devoluciones</option>
            <option>Pagos</option>
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="Agent" class="form-label">Número de agente</label>
        <input asp-for="Agent" inputmode="numeric" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Status" class="form-label">Estado</label>
        <select asp-for="Status" class="form-select">
            <option>Todos</option>
            <option>ERROR</option>
            <option>SUBIDO</option>
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Consultar</button>
    </div>
</form>

@if (Model.CanManage)
{
<details class="border rounded p-3 mb-4">
    <summary class="fw-bold">Limpiar resultados de un agente</summary>
    <p class="mt-3">Esta operación elimina los registros del estado elegido. No afecta a otros agentes.</p>
    <form method="post" asp-page-handler="Clear" class="row g-2">
        <div class="col-md-3">
            <label for="clear-agent" class="form-label">Número de agente</label>
            <input id="clear-agent" name="agent" inputmode="numeric" required class="form-control" />
        </div>
        <div class="col-md-3">
            <label for="clear-status" class="form-label">Estado</label>
            <select id="clear-status" name="status" class="form-select">
                <option>ERROR</option>
                <option>SUBIDO</option>
            </select>
        </div>
        <div class="col-md-3">
            <label for="clear-confirmation" class="form-label">Escriba LIMPIAR</label>
            <input id="clear-confirmation" name="confirmation" required class="form-control" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-outline-danger">Limpiar registros</button>
        </div>
    </form>
</details>
}

<section class="border rounded p-3 mb-4" aria-labelledby="transmission-actions-title">
    <h2 id="transmission-actions-title" class="h5">Acciones de envío</h2>
    <p>Estas acciones del sistema original todavía requieren integrar el archivo de señal y el FTP de Syncro Server. No están habilitadas para evitar indicar un envío que no ocurrió.</p>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-secondary" disabled>Solo subir</button>
        <button type="button" class="btn btn-outline-secondary" disabled>Recargar y subir</button>
        <button type="button" class="btn btn-outline-secondary" disabled>Recargar todos</button>
    </div>
</section>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
else if (Model.Items.Count == 0)
{
    <div class="alert alert-info" role="status">No hay transmisiones para los filtros seleccionados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Agente</th>
                    <th>Archivo</th>
                    <th>Consecutivo</th>
                    <th>Estado</th>
                    <th>Detalle</th>
                    <th>Fecha</th>
                    <th>Reintento</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Agent</td>
                        <td>@item.File</td>
                        <td>@item.Consecutive</td>
                        <td>@item.Status</td>
                        <td>@item.Detail</td>
                        <td>@item.Date</td>
                        <td>@item.Retry</td>
                        <td>
                            @if (Model.CanManage && item.Status.Trim() == "ERROR" && item.Retry != "1")
                            {
                                <form method="post" asp-page-handler="Retry">
                                    <input type="hidden" name="agent" value="@item.Agent" />
                                    <input type="hidden" name="file" value="@item.File" />
                                    <input type="hidden" name="consecutive" value="@item.Consecutive" />
                                    <input type="hidden" name="date" value="@item.Date" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm">Reintentar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Items.Count == 500)
    {
        <p>Se muestran los primeros 500 registros. Utilice los filtros para acotar la consulta.</p>
    }
}
