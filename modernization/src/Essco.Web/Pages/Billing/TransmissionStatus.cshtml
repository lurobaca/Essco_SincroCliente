@page
@model Essco.Web.Pages.Billing.TransmissionStatusModel
@{
    ViewData["Title"] = "Estado de transmisiones";
}

<div class="transmission-page">
<header class="mb-4">
    <h1 class="mb-2">Estado de transmisiones</h1>
    <p class="text-muted mb-0">Consulta de los resultados registrados por Syncro Cliente al transmitir archivos hacia SAP.</p>
</header>

@if (Model.Notice is not null)
{
    <div class="alert @(Model.NoticeIsError ? "transmission-feedback-error" : "transmission-feedback-success")" role="@(Model.NoticeIsError ? "alert" : "status")">@Model.Notice</div>
}

<section class="transmission-panel mb-4" aria-labelledby="transmission-summary-title">
    <h2 id="transmission-summary-title" class="h5 mb-3">Situación actual</h2>
<div class="row g-3">
    <div class="col-md-4">
        <div class="transmission-summary-item h-100">
            <span class="text-muted">Agente en secuencia</span>
            <strong class="d-block">@(Model.ActiveAgent ?? "Sin información")</strong>
        </div>
    </div>
    <div class="col-md-4">
        <div class="transmission-summary-item h-100">
            <span class="text-muted">Proceso actual</span>
            <strong class="d-block">@(Model.CurrentProcess ?? "Sin información")</strong>
        </div>
    </div>
    <div class="col-md-4">
        <div class="transmission-summary-item h-100">
            <span class="text-muted">Origen de descarga</span>
            <strong class="d-block mb-2">@(Model.DownloadFromFtp is null ? "Sin información" : Model.DownloadFromFtp.Value ? "FTP" : "Local")</strong>
            @if (Model.CanManage && Model.DownloadFromFtp is not null)
            {
                <form method="post" asp-page-handler="Source" data-confirm-message="¿Cambiar el origen de descarga a @(Model.DownloadFromFtp.Value ? "local" : "FTP")? Esto afecta al proceso de transmisión.">
                    <input type="hidden" name="downloadFromFtp" value="@(!Model.DownloadFromFtp.Value)" />
                    <button class="btn btn-outline-primary" type="submit">Cambiar a @(Model.DownloadFromFtp.Value ? "local" : "FTP")</button>
                </form>
            }
        </div>
    </div>
</div>
</section>

@if (Model.FtpAlerts.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        <strong>Alertas de FTP</strong>
        <ul class="mb-0 mt-2">
            @foreach (var alert in Model.FtpAlerts)
            {
                <li>@alert</li>
            }
        </ul>
    </div>
}

<section class="transmission-panel mb-4" aria-labelledby="transmission-filters-title">
<h2 id="transmission-filters-title" class="h5">Consultar transmisiones</h2>
<form method="get" class="row g-3 align-items-end">
    <div class="col-md-3">
        <label asp-for="FileType" class="form-label">Archivo</label>
        <select asp-for="FileType" class="form-select">
            <option>Todos</option>
            <option>Pedidos</option>
            <option>Devoluciones</option>
            <option>Pagos</option>
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="Agent" class="form-label">Número de agente</label>
        <input asp-for="Agent" inputmode="numeric" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Status" class="form-label">Estado</label>
        <select asp-for="Status" class="form-select">
            <option>Todos</option>
            <option>ERROR</option>
            <option>SUBIDO</option>
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">Consultar</button>
        <a asp-page="./TransmissionStatus" asp-route-FileType="Todos" asp-route-Status="Todos" class="btn btn-outline-primary">Limpiar filtros</a>
    </div>
</form>
</section>

<section class="mb-4" aria-labelledby="transmission-results-title">
<div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
    <h2 id="transmission-results-title" class="h4 mb-0">Resultados</h2>
    @if (Model.ErrorMessage is null)
    {
        <span class="text-muted">@Model.Items.Count registro(s) en esta consulta</span>
    }
</div>
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
else if (Model.Items.Count == 0)
{
    <div class="transmission-empty" role="status">
        <strong>No hay transmisiones para los filtros seleccionados.</strong>
        <p class="mb-2">Revise los criterios de búsqueda o consulte todos los estados.</p>
        <a asp-page="./TransmissionStatus" asp-route-FileType="Todos" asp-route-Status="Todos">Ver todos los registros</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle transmission-table">
            <caption>Resultados de transmisión registrados por Syncro Cliente</caption>
            <thead>
                <tr>
                    <th>Agente</th>
                    <th>Archivo</th>
                    <th>Consecutivo</th>
                    <th>Estado</th>
                    <th>Detalle</th>
                    <th>Fecha</th>
                    <th>Reintento</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Agent</td>
                        <td>@item.File</td>
                        <td>@item.Consecutive</td>
                        <td><span class="transmission-status @(item.Status.Trim() == "ERROR" ? "transmission-status-error" : item.Status.Trim() == "SUBIDO" ? "transmission-status-success" : "transmission-status-neutral")">@item.Status</span></td>
                        <td class="transmission-detail">@item.Detail</td>
                        <td>@item.Date</td>
                        <td>@item.Retry</td>
                        <td>
                            @if (Model.CanManage && item.Status.Trim() == "ERROR" && item.Retry != "1")
                            {
                                <form method="post" asp-page-handler="Retry" data-confirm-message="¿Marcar la transmisión @item.Consecutive del agente @item.Agent para reintento?">
                                    <input type="hidden" name="agent" value="@item.Agent" />
                                    <input type="hidden" name="file" value="@item.File" />
                                    <input type="hidden" name="consecutive" value="@item.Consecutive" />
                                    <input type="hidden" name="date" value="@item.Date" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm">Marcar para reintento</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Items.Count == 500)
    {
        <p>Se muestran los primeros 500 registros. Utilice los filtros para acotar la consulta.</p>
    }
}
</section>

<section class="transmission-panel mb-4" aria-labelledby="transmission-actions-title">
    <h2 id="transmission-actions-title" class="h5">Acciones de envío</h2>
    <p id="transmission-actions-help">Estas acciones del sistema original todavía requieren integrar el archivo de señal y el FTP de Syncro Server. No están habilitadas para evitar indicar un envío que no ocurrió.</p>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-secondary" aria-describedby="transmission-actions-help" disabled>Solo subir</button>
        <button type="button" class="btn btn-outline-secondary" aria-describedby="transmission-actions-help" disabled>Recargar y subir</button>
        <button type="button" class="btn btn-outline-secondary" aria-describedby="transmission-actions-help" disabled>Recargar todos</button>
    </div>
</section>

@if (Model.CanManage)
{
    <details class="transmission-panel mb-4">
        <summary class="fw-bold">Limpiar resultados de un agente</summary>
        <p class="mt-3">Esta operación elimina permanentemente los registros del estado elegido. No afecta a otros agentes.</p>
        <form method="post" asp-page-handler="Clear" class="row g-2">
            <div class="col-md-3">
                <label for="clear-agent" class="form-label">Número de agente</label>
                <input id="clear-agent" name="agent" inputmode="numeric" required class="form-control" />
            </div>
            <div class="col-md-3">
                <label for="clear-status" class="form-label">Estado</label>
                <select id="clear-status" name="status" class="form-select">
                    <option>ERROR</option>
                    <option>SUBIDO</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="clear-confirmation" class="form-label">Escriba LIMPIAR</label>
                <input id="clear-confirmation" name="confirmation" required class="form-control" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-danger">Limpiar registros</button>
            </div>
        </form>
    </details>
}
</div>

@section Scripts {
    <script src="~/js/transmission-status.js" asp-append-version="true"></script>
}
