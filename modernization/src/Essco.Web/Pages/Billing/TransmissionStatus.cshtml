@page
@model Essco.Web.Pages.Billing.TransmissionStatusModel
@{
    ViewData["Title"] = "Estado de transmisiones";
}

<div class="transmission-page" data-signals-url="@Url.Page("./TransmissionStatus", "Signals")">
    <h1>Estado de transmisiones</h1>

    @if (Model.Notice is not null)
    {
        <div class="alert @(Model.NoticeIsError ? "transmission-feedback-error" : "transmission-feedback-success") transmission-message"
             role="@(Model.NoticeIsError ? "alert" : "status")">@Model.Notice</div>
    }

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger transmission-message" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.FtpAlerts.Count > 0)
    {
        <div class="alert alert-warning transmission-message" role="alert">
            @foreach (string alert in Model.FtpAlerts)
            {
                <div>@alert</div>
            }
        </div>
    }

    <!-- La barra conserva las dos filas funcionales de EstadoSubida. -->
    <div class="transmission-toolbar" aria-label="Controles de estado de transmisiones">
        <form id="transmission-query" method="get" class="transmission-filter-group">
            <label asp-for="FileType">Archivo</label>
            <select asp-for="FileType" class="form-select form-select-sm">
                <option>Todos</option>
                <option>Pedidos</option>
                <option>Devoluciones</option>
                <option>Pagos</option>
            </select>
            <button class="btn btn-sm @(Model.Status == "Todos" ? "btn-primary" : "btn-outline-primary")"
                    type="submit" name="Status" value="Todos">Todos</button>
            <button class="btn btn-sm @(Model.Status == "ERROR" ? "btn-primary" : "btn-outline-primary")"
                    type="submit" name="Status" value="ERROR">Errores</button>
            <button class="btn btn-sm @(Model.Status == "SUBIDO" ? "btn-primary" : "btn-outline-primary")"
                    type="submit" name="Status" value="SUBIDO">Subidos</button>
        </form>

        @if (Model.CanManage)
        {
            <form method="post" asp-page-handler="Clear" class="transmission-clear-form" data-clear-status="ERROR">
                <input type="hidden" name="agent" />
                <input type="hidden" name="fileType" value="@Model.FileType" />
                <input type="hidden" name="status" value="ERROR" />
                <input type="hidden" name="confirmation" />
                <button type="submit" class="btn btn-sm btn-outline-danger">Limpiar Errores</button>
            </form>
            <form method="post" asp-page-handler="Clear" class="transmission-clear-form" data-clear-status="SUBIDO">
                <input type="hidden" name="agent" />
                <input type="hidden" name="fileType" value="@Model.FileType" />
                <input type="hidden" name="status" value="SUBIDO" />
                <input type="hidden" name="confirmation" />
                <button type="submit" class="btn btn-sm btn-outline-danger">Limpiar Subidos</button>
            </form>
        }

        <span class="transmission-indicator transmission-indicator-neutral" title="Nube estaba oculta y no tiene evento en WinForms">Nube</span>
        @if (Model.DownloadFromFtp is not null)
        {
            @if (Model.CanManage)
            {
                <form method="post" asp-page-handler="Source"
                      data-confirm-message="¿Cambiar el origen de descarga a @(Model.DownloadFromFtp.Value ? "local" : "FTP")?">
                    <input type="hidden" name="downloadFromFtp" value="@(!Model.DownloadFromFtp.Value)" />
                    <button id="transmission-source" type="submit"
                            class="btn btn-sm @(Model.DownloadFromFtp.Value ? "transmission-indicator-success" : "transmission-indicator-error")"
                            title="Cambiar origen de descarga">@(Model.DownloadFromFtp.Value ? "FTP" : "LOCAL")</button>
                </form>
            }
            else
            {
                <span id="transmission-source" class="transmission-indicator @(Model.DownloadFromFtp.Value ? "transmission-indicator-success" : "transmission-indicator-error")">
                    @(Model.DownloadFromFtp.Value ? "FTP" : "LOCAL")
                </span>
            }
        }
        else
        {
            <span id="transmission-source" class="transmission-indicator transmission-indicator-neutral">Origen desconocido</span>
        }
        <span id="transmission-today" class="transmission-indicator @(Model.TodayBlocked is true ? "transmission-indicator-error" : Model.TodayBlocked is false ? "transmission-indicator-success" : "transmission-indicator-neutral")">
            @(Model.TodayBlocked is true ? "HOY BLOQUEADO" : Model.TodayBlocked is false ? "HOY DESBLOQUEADO" : "HOY SIN INFORMACIÓN")
        </span>

        <div class="transmission-execution-row">
            <label for="transmission-agent-entry">#Agente</label>
            <input asp-for="Agent" id="transmission-agent-entry" form="transmission-query"
                   inputmode="numeric" pattern="[0-9]*" class="form-control form-control-sm"
                   aria-describedby="transmission-ftp-help" />
            @if (Model.CanDispatch)
            {
                <form method="post" asp-page-handler="Dispatch" class="transmission-dispatch-form"
                      data-confirm-message="Se limpiarán los estados del agente, se marcará la recarga y se enviará una señal al FTP. ¿Continuar?">
                    <input type="hidden" name="agent" />
                    <input type="hidden" name="mode" value="reload" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">Recargar y Subir</button>
                </form>
                <form method="post" asp-page-handler="Dispatch" class="transmission-dispatch-form"
                      data-confirm-message="Se limpiarán los estados del agente y se enviará una señal al FTP. ¿Continuar?">
                    <input type="hidden" name="agent" />
                    <input type="hidden" name="mode" value="upload" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">Solo Subir</button>
                </form>
                <form method="post" asp-page-handler="Dispatch"
                      data-confirm-message="Se limpiarán los estados y se enviará una señal por cada agente, excepto el código 1. Esta operación puede tardar. ¿Continuar?">
                    <input type="hidden" name="mode" value="all" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">Recargar Todos</button>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Recargar y Subir</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Solo Subir</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Recargar Todos</button>
            }
            <span class="transmission-current-agent">#Ag <strong id="transmission-active-agent">@(Model.ActiveAgent ?? "-")</strong></span>
            <output id="transmission-process" class="transmission-process" aria-label="Proceso actual">@(Model.CurrentProcess ?? "Sin información")</output>
        </div>
        <p id="transmission-ftp-help" class="transmission-toolbar-help">
            @if (Model.CanDispatch)
            {
                <text>El envío publica una señal FTP; Syncro Server confirma el procesamiento posteriormente. Para limpiar resultados, indique #Agente y confirme la operación.</text>
            }
            else if (Model.DispatchConfigured)
            {
                <text>El envío requiere permiso de administración. La consulta de transmisiones sigue disponible.</text>
            }
            else
            {
                <text>El envío está deshabilitado hasta configurar un FTP y Syncro Server aislados para este entorno. Para limpiar resultados, indique #Agente y confirme la operación.</text>
            }
        </p>
    </div>

    <!-- El grid conserva las siete columnas vinculadas en tiempo de ejecución en WinForms. -->
    <div class="transmission-grid table-responsive" role="region" aria-label="Resultados de transmisiones" tabindex="0">
        <table class="table table-striped table-hover table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">Fecha</th>
                    <th scope="col">Archivo</th>
                    <th scope="col">Agente</th>
                    <th scope="col">Consecutivo</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Detalle</th>
                    <th scope="col">Reintento</th>
                    <th scope="col">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Date</td>
                        <td>@item.File</td>
                        <td>@item.Agent</td>
                        <td>@item.Consecutive</td>
                        <td><span class="transmission-status @(item.Status.Trim() == "ERROR" ? "transmission-status-error" : item.Status.Trim() == "SUBIDO" ? "transmission-status-success" : "transmission-status-neutral")">@item.Status</span></td>
                        <td class="transmission-detail">@item.Detail</td>
                        <td>@item.Retry</td>
                        <td>
                            @if (Model.CanManage && item.Status.Trim() == "ERROR" && item.Retry != "1")
                            {
                                <form method="post" asp-page-handler="Retry"
                                      data-confirm-message="¿Marcar la transmisión @item.Consecutive del agente @item.Agent para reintento?">
                                    <input type="hidden" name="agent" value="@item.Agent" />
                                    <input type="hidden" name="file" value="@item.File" />
                                    <input type="hidden" name="consecutive" value="@item.Consecutive" />
                                    <input type="hidden" name="date" value="@item.Date" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Reintentar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.ErrorMessage is null && Model.Items.Count == 0)
        {
            <p class="transmission-grid-empty" role="status">No hay transmisiones para los filtros seleccionados.</p>
        }
    </div>
    @if (Model.Items.Count == 500)
    {
        <p class="small mt-2">Se muestran los primeros 500 registros. Utilice Archivo, #Agente o estado para acotar la consulta.</p>
    }
</div>

@section Scripts {
    <script src="~/js/transmission-status.js" asp-append-version="true"></script>
}
