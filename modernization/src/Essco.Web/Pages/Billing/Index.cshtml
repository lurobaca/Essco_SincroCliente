@page
@model Essco.Web.Pages.Billing.IndexModel
@{ViewData["Title"]="Facturas";}<h1>Facturación electrónica</h1><form method="get" class="row g-2 mb-3"><div class="col"><input asp-for="Search" placeholder="Documento, clave o cliente" class="form-control"/></div><div class="col"><input asp-for="From" type="date" class="form-control"/></div><div class="col"><input asp-for="To" type="date" class="form-control"/></div><div class="col"><input asp-for="HaciendaStatus" placeholder="Estado Hacienda" class="form-control"/></div><div class="col-auto"><button class="btn btn-primary">Buscar</button></div></form><table class="table table-striped"><thead><tr><th>Documento</th><th>Fecha</th><th>Cliente</th><th>Total</th><th>Hacienda</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><a asp-page="Detail" asp-route-number="@x.DocumentNumber">@x.DocumentNumber</a><br/><small>@x.Consecutive</small></td><td>@x.IssueDate</td><td>@x.CustomerCode - @x.CustomerName</td><td>@x.Currency @x.Total.ToString("N2")</td><td>@x.HaciendaStatus<br/><small>@x.HaciendaMessage</small></td></tr>}</tbody></table>
