@page "{number}"
@model Essco.Web.Pages.Billing.DetailModel
@{
    ViewData["Title"] = "Factura";
}

<p><a asp-page="Index">← Facturas</a></p>
<h1>Factura @Model.Invoice.DocumentNumber</h1>

<!-- Información general de la factura -->
<dl class="row">
    <dt class="col-sm-2">Clave</dt>
    <dd class="col-sm-10 text-break">@Model.Invoice.Key</dd>
    <dt class="col-sm-2">Consecutivo</dt>
    <dd class="col-sm-10">@Model.Invoice.Consecutive</dd>
    <dt class="col-sm-2">Cliente</dt>
    <dd class="col-sm-10">@Model.Invoice.CustomerCode - @Model.Invoice.CustomerName (@Model.Invoice.CustomerIdentification)</dd>
    <dt class="col-sm-2">Hacienda</dt>
    <dd class="col-sm-10">@Model.Invoice.HaciendaStatus — @Model.Invoice.HaciendaMessage</dd>
</dl>

<!-- Líneas y totales de la factura -->
<table class="table">
    <thead>
        <tr><th>#</th><th>Artículo</th><th>CABYS</th><th>Cantidad</th><th>Precio</th><th>Descuento</th><th>Impuesto</th><th>Total</th></tr>
    </thead>
    <tbody>
        @foreach (var line in Model.Invoice.Lines)
        {
            <tr>
                <td>@line.Number</td><td>@line.ItemCode - @line.Description</td><td>@line.Cabys</td>
                <td>@line.Quantity @line.Unit</td><td>@line.UnitPrice.ToString("N2")</td>
                <td>@line.Discount.ToString("N2")</td><td>@line.Tax.ToString("N2")</td><td>@line.Total.ToString("N2")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr><th colspan="5"></th><th>@Model.Invoice.Discount.ToString("N2")</th><th>@Model.Invoice.Tax.ToString("N2")</th><th>@Model.Invoice.Total.ToString("N2")</th></tr>
    </tfoot>
</table>
<p><strong>Comentarios:</strong> @Model.Invoice.Comments</p>
