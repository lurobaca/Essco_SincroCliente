@page "{number}"
@model Essco.Web.Pages.Billing.DetailModel
@{ViewData["Title"]="Factura";}<p><a asp-page="Index">← Facturas</a></p><h1>Factura @Model.Invoice.DocumentNumber</h1><dl class="row"><dt class="col-sm-2">Clave</dt><dd class="col-sm-10 text-break">@Model.Invoice.Key</dd><dt class="col-sm-2">Consecutivo</dt><dd class="col-sm-10">@Model.Invoice.Consecutive</dd><dt class="col-sm-2">Cliente</dt><dd class="col-sm-10">@Model.Invoice.CustomerCode - @Model.Invoice.CustomerName (@Model.Invoice.CustomerIdentification)</dd><dt class="col-sm-2">Hacienda</dt><dd class="col-sm-10">@Model.Invoice.HaciendaStatus — @Model.Invoice.HaciendaMessage</dd></dl><table class="table"><thead><tr><th>#</th><th>Artículo</th><th>CABYS</th><th>Cantidad</th><th>Precio</th><th>Descuento</th><th>Impuesto</th><th>Total</th></tr></thead><tbody>@foreach(var x in Model.Invoice.Lines){<tr><td>@x.Number</td><td>@x.ItemCode - @x.Description</td><td>@x.Cabys</td><td>@x.Quantity @x.Unit</td><td>@x.UnitPrice.ToString("N2")</td><td>@x.Discount.ToString("N2")</td><td>@x.Tax.ToString("N2")</td><td>@x.Total.ToString("N2")</td></tr>}</tbody><tfoot><tr><th colspan="5"></th><th>@Model.Invoice.Discount.ToString("N2")</th><th>@Model.Invoice.Tax.ToString("N2")</th><th>@Model.Invoice.Total.ToString("N2")</th></tr></tfoot></table><p><strong>Comentarios:</strong> @Model.Invoice.Comments</p>
