@page
@model Essco.Web.Pages.Products.IndexModel
@{ViewData["Title"]="Artículos";}<h1>Artículos</h1><p><a asp-page="Discounts">Descuentos</a> · <a asp-page="PriceLists">Listas de precios</a></p><form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col"><input asp-for="Search" placeholder="Buscar" class="form-control"/></div><div class="col"><input asp-for="Type" placeholder="Tipo de producto" class="form-control"/></div></div><label class="form-check"><input asp-for="ByDescription" class="form-check-input"/> Buscar por descripción</label><button class="btn btn-outline-primary">Buscar</button></form><table class="table table-striped"><thead><tr><th>Código</th><th>Descripción</th><th>Tipo</th><th>Marca</th><th>CABYS</th><th class="text-end">Precio</th><th>Moneda</th><th>Impuesto</th><th>SAP</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Code</td><td>@x.Description</td><td>@x.ProductType</td><td>@x.Brand</td><td>@x.Cabys</td><td class="text-end">@x.Price.ToString("N2")</td><td>@x.Currency</td><td>@x.TaxRate</td><td>@(x.CreatedInSap?"Sí":"No")</td></tr>}</tbody></table>
