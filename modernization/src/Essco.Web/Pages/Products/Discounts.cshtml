@page
@model Essco.Web.Pages.Products.DiscountsModel
@{ViewData["Title"]="Descuentos";}<h1>Descuentos automáticos</h1><p><a asp-page="Index">Artículos</a></p>@if(Model.StatusMessage is not null){<div class="alert alert-info">@Model.StatusMessage</div>}<form method="post" asp-page-handler="Save" class="card card-body mb-3"><input asp-for="Input.IsNew" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="row g-2"><div class="col"><input asp-for="Input.ProductCode" placeholder="Artículo" class="form-control"/></div><div class="col"><input asp-for="Input.Description" placeholder="Descripción" class="form-control"/></div><div class="col"><input asp-for="Input.Percentage" placeholder="% descuento" class="form-control"/></div><div class="col"><input asp-for="Input.From" class="form-control"/></div><div class="col"><input asp-for="Input.To" class="form-control"/></div><div class="col"><input asp-for="Input.MinimumQuantity" placeholder="Cantidad mínima" class="form-control"/></div><div class="col"><input asp-for="Input.AvailableQuantity" placeholder="Disponible" class="form-control"/></div></div><input asp-for="Input.Comments" placeholder="Comentario" class="form-control mt-2"/><button class="btn btn-primary mt-2">Guardar</button></form><table class="table"><thead><tr><th>Artículo</th><th>Descuento</th><th>Vigencia</th><th>Cantidad</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.ProductCode - @x.Description</td><td>@x.Percentage%</td><td>@x.From — @x.To</td><td>@x.MinimumQuantity / @x.AvailableQuantity</td><td><a asp-route-edit="@x.ProductCode" class="btn btn-sm btn-outline-secondary">Editar</a><form method="post" asp-page-handler="Delete" class="d-inline"><input type="hidden" name="code" value="@x.ProductCode"/><button class="btn btn-sm btn-outline-danger">Eliminar</button></form></td></tr>}</tbody></table>
