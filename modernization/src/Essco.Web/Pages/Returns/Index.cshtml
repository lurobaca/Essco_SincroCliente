@page
@model Essco.Web.Pages.Returns.IndexModel
@{ViewData["Title"]="Devoluciones";}<h1>Devoluciones</h1>@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="alert alert-info">@Model.StatusMessage</div>}<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col"><input asp-for="Filter.Number" placeholder="Número" class="form-control"/></div><div class="col"><input asp-for="Filter.Driver" placeholder="Chofer/agente" class="form-control"/></div><div class="col"><select asp-for="Filter.Status" class="form-select"><option value="Pending">Pendientes</option><option value="Processed">Procesadas</option><option value="All">Todas</option></select></div></div><button class="btn btn-outline-primary mt-2">Buscar</button></form>
@if(Model.Selected is not null){<section class="card card-body mb-3"><h2>Devolución @Model.Selected.Number</h2><p>@Model.Selected.CustomerCode - @Model.Selected.CustomerName · Factura @Model.Selected.InvoiceNumber · @Model.Selected.Reason</p><table class="table"><thead><tr><th>Artículo</th><th>Cantidad</th><th>Precio</th><th>Total</th><th>Motivo</th></tr></thead><tbody>@foreach(var line in Model.Selected.Lines){<tr><td>@line.ItemCode - @line.ItemName</td><td>@line.Quantity</td><td>@line.Price.ToString("N2")</td><td>@line.Total.ToString("N2")</td><td>@line.Reason</td></tr>}</tbody></table></section>}
<table class="table table-striped"><thead><tr><th>#</th><th>Fecha</th><th>Cliente</th><th>Chofer</th><th>Factura</th><th class="text-end">Total</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Number</td><td>@x.Date</td><td>@x.CustomerCode - @x.CustomerName</td><td>@x.DriverCode</td><td>@x.InvoiceNumber</td><td class="text-end">@x.Total.ToString("N2")</td><td>@(x.Processed?$"Procesada SAP {x.SapDocumentEntry}":"Pendiente")</td><td><a asp-route-view="@x.Number" class="btn btn-sm btn-outline-secondary">Detalle</a>@if(!x.Processed){<form method="post" asp-page-handler="Process" class="d-inline"><input type="hidden" name="number" value="@x.Number"/><button class="btn btn-sm btn-primary" onclick="return confirm('¿Crear la nota de crédito en SAP?')">Procesar</button></form>}</td></tr>}</tbody></table>
