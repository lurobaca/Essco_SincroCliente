@page
@model Essco.Web.Pages.Returns.IndexModel
@{ViewData["Title"]="Devoluciones";}
<h1>Devoluciones</h1>
@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="alert alert-info" role="status">@Model.StatusMessage</div>}
<form method="get" class="card card-body mb-3">
 <div class="row g-2">
  <div class="col"><label asp-for="Filter.Number" class="visually-hidden">Número</label><input asp-for="Filter.Number" placeholder="Número" class="form-control"/></div>
  <div class="col"><label asp-for="Filter.Driver" class="visually-hidden">Chofer o agente</label><input asp-for="Filter.Driver" placeholder="Chofer/agente" class="form-control"/></div>
  <div class="col"><label asp-for="Filter.Status" class="visually-hidden">Estado</label><select asp-for="Filter.Status" class="form-select"><option value="Pending">Pendientes</option><option value="Processed">Procesadas</option><option value="All">Todas</option></select></div>
 </div><button class="btn btn-outline-primary mt-2">Buscar</button>
</form>
@if(Model.Selected is not null)
{
 <section class="card card-body mb-3">
  <h2>Devolución @Model.Selected.Number</h2>
  <p>@Model.Selected.CustomerCode - @Model.Selected.CustomerName · Factura @Model.Selected.InvoiceNumber · @Model.Selected.Reason</p>
  @if(!Model.Selected.Processed && Model.Selected.Lines.Any(x=>string.IsNullOrWhiteSpace(x.Warehouse)))
  {<div class="alert alert-warning">La base actual no proporciona bodega para una o más líneas. Puedes guardar el preliminar, pero el envío a SAP permanecerá bloqueado hasta configurar las bodegas.</div>}
  @if(!Model.Selected.Processed)
  {
   <div class="card card-body mb-3">
    <h3 class="h6">Agregar artículo al preliminar</h3>
    <form method="get" class="row g-2"><input type="hidden" name="view" value="@Model.Selected.Number"/><div class="col"><label class="visually-hidden" for="product-search">Descripción del artículo</label><input id="product-search" name="ProductSearch" value="@Model.ProductSearch" placeholder="Buscar por descripción" class="form-control" required/></div><div class="col-auto"><button class="btn btn-outline-primary">Buscar</button></div></form>
    @if(Model.ProductOptions.Count>0){<div class="list-group mt-2">@foreach(var product in Model.ProductOptions.Take(25)){<form method="post" asp-page-handler="AddLine" class="list-group-item d-flex justify-content-between align-items-center"><input type="hidden" name="NewLine.Number" value="@Model.Selected.Number"/><input type="hidden" name="NewLine.ItemCode" value="@product.Code"/><span><strong>@product.Code</strong> — @product.Description <small class="text-muted">Precio @product.Price.ToString("N2") · IVA @product.TaxRate%</small></span><button class="btn btn-sm btn-outline-primary">Agregar</button></form>}</div>}
    <small class="text-muted mt-2">Precio, descripción e impuesto se toman del catálogo; no se aceptan valores escritos manualmente.</small>
   </div>
  }
  <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Artículo</th><th>Cantidad</th><th>Descuentos</th><th>Total</th><th>Motivo y comentarios</th><th>Acción</th></tr></thead><tbody>
  @foreach(var line in Model.Selected.Lines)
  {
   <tr>
   @if(Model.Selected.Processed)
   {
    <td>@line.ItemCode - @line.ItemName</td><td>@line.Quantity</td><td>@line.FixedDiscount% + @line.PromotionalDiscount%</td><td>@line.Total.ToString("N2")</td><td>@line.Reason<br/><small>@line.Comments</small></td><td>Procesada</td>
   }
   else
   {
    <form method="post" asp-page-handler="SaveLine">
     <td>@line.ItemCode - @line.ItemName<input type="hidden" name="Input.Number" value="@Model.Selected.Number"/><input type="hidden" name="Input.LineNumber" value="@line.LineNumber"/><input type="hidden" name="number" value="@Model.Selected.Number"/><input type="hidden" name="lineNumber" value="@line.LineNumber"/></td>
     <td><label class="visually-hidden" for="q-@line.LineNumber">Cantidad</label><input id="q-@line.LineNumber" name="Input.Quantity" value="@line.Quantity" type="number" min="1" step="1" class="form-control return-number"/></td>
     <td><div class="d-flex gap-1"><div><label class="small" for="f-@line.LineNumber">Fijo %</label><input id="f-@line.LineNumber" name="Input.FixedDiscount" value="@line.FixedDiscount" type="number" min="0" max="100" step="0.01" class="form-control return-number"/></div><div><label class="small" for="p-@line.LineNumber">Promo %</label><input id="p-@line.LineNumber" name="Input.PromotionalDiscount" value="@line.PromotionalDiscount" type="number" min="0" max="100" step="0.01" class="form-control return-number"/></div></div></td>
     <td>@line.Total.ToString("N2")</td>
     <td><label class="visually-hidden" for="r-@line.LineNumber">Motivo</label><input id="r-@line.LineNumber" name="Input.Reason" value="@line.Reason" maxlength="200" required class="form-control mb-1"/><label class="visually-hidden" for="c-@line.LineNumber">Comentarios</label><input id="c-@line.LineNumber" name="Input.Comments" value="@line.Comments" maxlength="200" placeholder="Comentarios" class="form-control"/></td>
     <td><button class="btn btn-sm btn-primary mb-1">Guardar preliminar</button><button asp-page-handler="DeleteLine" class="btn btn-sm btn-outline-danger" formnovalidate onclick="return confirm('¿Eliminar esta línea del preliminar?')">Eliminar</button></td>
    </form>
   }
   </tr>
  }</tbody></table></div>
 </section>
}
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>#</th><th>Fecha</th><th>Cliente</th><th>Chofer</th><th>Factura</th><th class="text-end">Total</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach(var item in Model.Items)
{
 <tr><td>@item.Number</td><td>@item.Date</td><td>@item.CustomerCode - @item.CustomerName</td><td>@item.DriverCode</td><td>@item.InvoiceNumber</td><td class="text-end">@item.Total.ToString("N2")</td><td>@(item.Processed?$"Procesada SAP {item.SapDocumentEntry}":"Pendiente")</td><td><a asp-route-view="@item.Number" class="btn btn-sm btn-outline-secondary">Detalle</a>
 @if(!item.Processed){<form method="post" asp-page-handler="Process" class="d-inline"><input type="hidden" name="number" value="@item.Number"/><button class="btn btn-sm btn-primary" onclick="return confirm('¿Crear la nota de crédito en SAP?')">Procesar</button></form>}</td></tr>
}</tbody></table></div>
