@page "{id}"
@model Essco.Web.Pages.Employees.CompensationModel
@{ViewData["Title"]="Compensación del empleado";}
<p><a asp-page="Detail" asp-route-id="@Model.EmployeeId">← Expediente</a></p><h1>Compensación de @Model.EmployeeName</h1>@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="alert alert-info">@Model.StatusMessage</div>}
<div class="row g-4"><div class="col-lg-6"><h2>Nuevo aumento salarial</h2><p>El porcentaje se aplica al salario actual y ambos cambios se guardan en una sola transacción.</p><form method="post" asp-page-handler="Increase"><label asp-for="Increase.Date"></label><input asp-for="Increase.Date" type="date" class="form-control"/><label asp-for="Increase.Percentage"></label><input asp-for="Increase.Percentage" class="form-control"/><label asp-for="Increase.Reason"></label><textarea asp-for="Increase.Reason" class="form-control"></textarea><button class="btn btn-primary mt-2">Aplicar aumento</button></form></div>
<div class="col-lg-6"><h2>Nuevo adicional</h2><form method="post" asp-page-handler="Additional"><label asp-for="Additional.Type"></label><select asp-for="Additional.Type" class="form-select"><option value="">Seleccione</option>@foreach(var type in Model.AdditionalTypes){<option>@type</option>}</select><label asp-for="Additional.Amount"></label><input asp-for="Additional.Amount" class="form-control"/><button class="btn btn-primary mt-2">Agregar</button></form></div></div>
<h2 class="mt-4">Historial de aumentos</h2><table class="table"><thead><tr><th>Fecha</th><th>Anterior</th><th>%</th><th>Aumento</th><th>Nuevo salario</th><th>Motivo</th><th>Usuario</th></tr></thead><tbody>@foreach(var x in Model.Increases){<tr><td>@x.Date</td><td>@x.PreviousSalary.ToString("N2")</td><td>@x.Percentage</td><td>@x.Amount.ToString("N2")</td><td>@x.NewSalary.ToString("N2")</td><td>@x.Reason</td><td>@x.CreatedBy</td></tr>}</tbody></table>
<div class="d-flex justify-content-between align-items-center"><h2>Adicionales</h2>@if(Model.Additionals.Any(x=>!x.Annulled)){<form method="post" asp-page-handler="AnnulAdditionals"><button class="btn btn-outline-danger">Anular adicionales activos</button></form>}</div><table class="table"><thead><tr><th>Fecha</th><th>Tipo</th><th>Monto</th><th>Estado</th></tr></thead><tbody>@foreach(var x in Model.Additionals){<tr><td>@x.CreatedAt</td><td>@x.Type</td><td>@x.Amount.ToString("N2")</td><td>@(x.Annulled?"Anulado":"Activo")</td></tr>}</tbody></table>
