@page
@model Essco.Web.Pages.Employees.IndexModel
@{ViewData["Title"]="Empleados";}<div class="d-flex justify-content-between align-items-center"><div><h1>Empleados</h1><p>@Model.Items.Count registro(s)</p></div><a asp-page="Edit" class="btn btn-primary">Nuevo empleado</a></div><form method="get" class="row g-2 mb-3"><div class="col"><input asp-for="Search" placeholder="Cédula, código o nombre" class="form-control"/></div><div class="col form-check"><input asp-for="IncludeInactive" class="form-check-input"/><label asp-for="IncludeInactive">Incluir inactivos</label></div><div class="col-auto"><button class="btn btn-primary">Buscar</button></div></form><table class="table"><thead><tr><th>Empleado</th><th>Puesto</th><th>Ingreso</th><th>Salario</th><th>Vacaciones</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><a asp-page="Detail" asp-route-id="@x.Identification">@x.Code - @x.Name</a><br/><small>@x.Identification</small></td><td>@x.Position</td><td>@x.HireDate</td><td>@x.Salary.ToString("N2")</td><td>@x.VacationPending</td><td>@(x.Active?"Activo":"Inactivo")</td><td><a asp-page="Edit" asp-route-id="@x.Identification" class="btn btn-sm btn-outline-primary">Editar</a></td></tr>}</tbody></table>
