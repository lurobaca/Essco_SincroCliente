@page "{id?}"
@model Essco.Web.Pages.Employees.EditModel
@{ViewData["Title"]=Model.IsNew?"Nuevo empleado":"Editar empleado";}
<p><a asp-page="Index">← Empleados</a></p><h1>@ViewData["Title"]</h1><p>Complete la información laboral y de planilla del colaborador.</p>
<div asp-validation-summary="All" class="alert alert-danger"></div>
<form method="post"><input type="hidden" asp-for="OriginalIdentification" />
<div class="row g-3"><div class="col-md-4"><label asp-for="Input.Identification"></label><input asp-for="Input.Identification" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.Code"></label><input asp-for="Input.Code" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.Active"></label><select asp-for="Input.Active" class="form-select"><option value="true">Activo</option><option value="false">Inactivo</option></select></div>
<div class="col-md-8"><label asp-for="Input.Name"></label><input asp-for="Input.Name" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.HireDate"></label><input asp-for="Input.HireDate" type="date" class="form-control" /></div><div class="col-md-6"><label asp-for="Input.Position"></label><input asp-for="Input.Position" class="form-control" /></div><div class="col-md-3"><label asp-for="Input.Category"></label><input asp-for="Input.Category" class="form-control" /></div><div class="col-md-3"><label asp-for="Input.Salary"></label><input asp-for="Input.Salary" class="form-control" /></div>
<div class="col-md-4"><label asp-for="Input.Phone1"></label><input asp-for="Input.Phone1" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.Phone2"></label><input asp-for="Input.Phone2" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.Email"></label><input asp-for="Input.Email" type="email" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.Route"></label><input asp-for="Input.Route" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.BankAccount"></label><input asp-for="Input.BankAccount" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.CollaboratorId"></label><input asp-for="Input.CollaboratorId" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.LedgerAccount"></label><input asp-for="Input.LedgerAccount" class="form-control" /></div>
<div class="col-md-8"><fieldset><legend class="fs-6">Vacaciones</legend><div class="row g-2"><div class="col"><label asp-for="Input.VacationEarned"></label><input asp-for="Input.VacationEarned" class="form-control" /></div><div class="col"><label asp-for="Input.VacationUsed"></label><input asp-for="Input.VacationUsed" class="form-control" /></div><div class="col"><label asp-for="Input.VacationPending"></label><input asp-for="Input.VacationPending" class="form-control" /></div></div></fieldset></div></div>
<div class="mt-4"><button class="btn btn-primary">Guardar empleado</button> <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a></div></form>
