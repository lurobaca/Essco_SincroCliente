@page "{id?}"
@model Essco.Web.Pages.Employees.EditModel
@{ViewData["Title"]=Model.IsNew?"Nuevo empleado":"Editar empleado";}
<p><a asp-page="Index">← Empleados</a></p><h1>@ViewData["Title"]</h1><p>Complete la información laboral y de planilla del colaborador.</p>
<div asp-validation-summary="All" class="alert alert-danger"></div>
<form method="post" enctype="multipart/form-data"><input type="hidden" asp-for="OriginalIdentification" /><input type="hidden" asp-for="Input.Active" />
<div class="row g-3"><div class="col-md-4"><label asp-for="Input.Identification"></label><input asp-for="Input.Identification" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.Code"></label><input asp-for="Input.Code" class="form-control" maxlength="15" /></div><div class="col-md-4"><label>Estado</label><div class="form-control-plaintext"><span class="badge @(Model.Input.Active?"text-bg-success":"text-bg-secondary")">@(Model.Input.Active?"Activo":"Inactivo")</span></div></div>
<div class="col-md-8"><label asp-for="Input.Name"></label><input asp-for="Input.Name" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.HireDate"></label><input asp-for="Input.HireDate" type="date" class="form-control" /></div><div class="col-md-6"><label asp-for="Input.Position"></label><select asp-for="Input.Position" class="form-select"><option value="">Seleccione un puesto</option>@foreach(var position in Model.Positions){<option value="@position">@position</option>}</select></div><div class="col-md-3"><label asp-for="Input.Category"></label><select asp-for="Input.Category" class="form-select"><option value="">Seleccione una categoría</option>@foreach(var category in Model.Categories){<option value="@category">@category</option>}</select></div><div class="col-md-3"><label asp-for="Input.Salary"></label><input asp-for="Input.Salary" class="form-control" id="employee-salary" /></div><div class="col-md-3"><label>Salario quincenal</label><output id="fortnight-salary" class="form-control-plaintext"></output></div><div class="col-md-3"><label>Salario diario</label><output id="daily-salary" class="form-control-plaintext"></output></div><div class="col-md-6"><label>Antigüedad calculada</label><div class="form-control-plaintext">@Model.Tenure.Years año(s), @Model.Tenure.Months mes(es), @Model.Tenure.Days día(s)</div></div>
<div class="col-md-4"><label asp-for="Input.Phone1"></label><input asp-for="Input.Phone1" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.Phone2"></label><input asp-for="Input.Phone2" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.Email"></label><input asp-for="Input.Email" type="email" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.Route"></label><input asp-for="Input.Route" class="form-control" id="employee-route" /></div><div class="col-md-4"><label asp-for="Input.BankAccount"></label><input asp-for="Input.BankAccount" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.CollaboratorId"></label><input asp-for="Input.CollaboratorId" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.LedgerAccount"></label><input asp-for="Input.LedgerAccount" class="form-control" maxlength="15" /></div><div class="col-md-4"><label for="Photo">Fotografía</label><input asp-for="Photo" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" /><span asp-validation-for="Photo" class="text-danger"></span></div>@if(!Model.IsNew){<div class="col-md-2"><img src="?handler=Photo&id=@Model.OriginalIdentification" alt="Fotografía del empleado" class="img-thumbnail" style="max-height:120px" onerror="this.style.display='none'" /></div>}
<div class="col-md-8"><fieldset><legend class="fs-6">Vacaciones</legend><div class="row g-2"><div class="col"><label asp-for="Input.VacationEarned"></label><input asp-for="Input.VacationEarned" class="form-control" /></div><div class="col"><label asp-for="Input.VacationUsed"></label><input asp-for="Input.VacationUsed" class="form-control" /></div><div class="col"><label asp-for="Input.VacationPending"></label><input asp-for="Input.VacationPending" class="form-control" /></div></div></fieldset></div></div>
<div class="mt-4"><button class="btn btn-primary">Guardar empleado</button> <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>@if(!Model.IsNew&&Model.Input.Active){<button type="submit" asp-page-handler="Deactivate" class="btn btn-outline-danger float-end" formnovalidate onclick="return confirm('¿Está seguro que desea inactivar al empleado?');">Inactivar empleado</button>}</div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>(()=>{const position=document.getElementById('Input_Position'),route=document.getElementById('employee-route'),salary=document.getElementById('employee-salary'),fortnight=document.getElementById('fortnight-salary'),daily=document.getElementById('daily-salary');function syncRoute(){const agent=position?.value.toUpperCase()==='AGENTE';if(route){route.disabled=!agent;if(!agent)route.value='0';}}function syncSalary(){const value=Number(salary?.value||0);fortnight.textContent=(value/2).toLocaleString('es-CR',{minimumFractionDigits:2});daily.textContent=(value/30).toLocaleString('es-CR',{minimumFractionDigits:2});}position?.addEventListener('change',syncRoute);salary?.addEventListener('input',syncSalary);syncRoute();syncSalary();})();</script>}
