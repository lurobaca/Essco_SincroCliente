@page "{id?}"
@model Essco.Web.Pages.Employees.EditModel
@{ViewData["Title"]=Model.IsNew?"Nuevo empleado":"Editar empleado";}
<p><a asp-page="Index">← Empleados</a></p>
<h1>@ViewData["Title"]</h1>
<p>Los campos marcados con <span class="required-mark" aria-hidden="true">*</span> son obligatorios.</p>
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<form method="post" enctype="multipart/form-data" novalidate>
 <input type="hidden" asp-for="OriginalIdentification" />
 <input type="hidden" asp-for="Input.VacationEarned" /><input type="hidden" asp-for="Input.VacationUsed" /><input type="hidden" asp-for="Input.VacationPending" />
 <div class="row g-3">
  <div class="col-md-4"><label asp-for="Input.Identification">Cédula <span class="required-mark" aria-hidden="true">*</span></label><input asp-for="Input.Identification" class="form-control" required aria-required="true"/><span asp-validation-for="Input.Identification" class="invalid-feedback d-block"></span></div>
  <div class="col-md-4"><label asp-for="Input.Code"></label><input asp-for="Input.Code" class="form-control" maxlength="15" aria-describedby="code-help"/><div id="code-help" class="form-text">Opcional. Si se indica, debe existir en SAP.</div><span asp-validation-for="Input.Code" class="invalid-feedback d-block"></span></div>
  <div class="col-md-4"><label>Estado</label><div class="form-control-plaintext"><span class="badge text-bg-success">Activo</span></div></div>
  <div class="col-md-8"><label asp-for="Input.Name">Nombre completo <span class="required-mark" aria-hidden="true">*</span></label><input asp-for="Input.Name" class="form-control" required aria-required="true"/><span asp-validation-for="Input.Name" class="invalid-feedback d-block"></span></div>
  <div class="col-md-4"><label asp-for="Input.HireDate">Fecha de ingreso <span class="required-mark" aria-hidden="true">*</span></label><input asp-for="Input.HireDate" type="date" class="form-control" required aria-required="true"/><span asp-validation-for="Input.HireDate" class="invalid-feedback d-block"></span></div>
  <div class="col-md-6"><label asp-for="Input.Position">Puesto <span class="required-mark" aria-hidden="true">*</span></label><select asp-for="Input.Position" class="form-select" required aria-required="true"><option value="">Seleccione un puesto</option>@foreach(var value in Model.Positions){<option value="@value">@value</option>}</select><span asp-validation-for="Input.Position" class="invalid-feedback d-block"></span></div>
  <div class="col-md-3"><label asp-for="Input.Category">Categoría <span class="required-mark" aria-hidden="true">*</span></label><select asp-for="Input.Category" class="form-select" required aria-required="true"><option value="">Seleccione una categoría</option>@foreach(var value in Model.Categories){<option value="@value">@value</option>}</select><span asp-validation-for="Input.Category" class="invalid-feedback d-block"></span></div>
  <div class="col-md-3"><label asp-for="Input.Salary">Salario mensual <span class="required-mark" aria-hidden="true">*</span></label><input asp-for="Input.Salary" class="form-control" id="employee-salary" required aria-required="true"/><span asp-validation-for="Input.Salary" class="invalid-feedback d-block"></span></div>
  <div class="col-md-3"><label>Salario quincenal</label><output id="fortnight-salary" class="form-control-plaintext"></output></div><div class="col-md-3"><label>Salario diario</label><output id="daily-salary" class="form-control-plaintext"></output></div><div class="col-md-6"><label>Antigüedad calculada</label><div class="form-control-plaintext">@Model.Tenure.Years año(s), @Model.Tenure.Months mes(es), @Model.Tenure.Days día(s)</div></div>
  <div class="col-md-4"><label asp-for="Input.Phone1"></label><input asp-for="Input.Phone1" class="form-control"/></div><div class="col-md-4"><label asp-for="Input.Phone2"></label><input asp-for="Input.Phone2" class="form-control"/></div><div class="col-md-4"><label asp-for="Input.Email"></label><input asp-for="Input.Email" type="email" class="form-control"/><span asp-validation-for="Input.Email" class="invalid-feedback d-block"></span></div>
  <div class="col-md-4"><label asp-for="Input.Route">Ruta <span id="route-required" class="required-mark" aria-hidden="true" hidden>*</span></label><input asp-for="Input.Route" class="form-control" id="employee-route"/><div class="form-text">Obligatoria únicamente para el puesto Agente.</div><span asp-validation-for="Input.Route" class="invalid-feedback d-block"></span></div>
  <div class="col-md-4"><label asp-for="Input.BankAccount">Cuenta bancaria <span class="required-mark" aria-hidden="true">*</span></label><input asp-for="Input.BankAccount" class="form-control" required aria-required="true"/><span asp-validation-for="Input.BankAccount" class="invalid-feedback d-block"></span></div>
  <div class="col-md-4"><label asp-for="Input.CollaboratorId">Id. colaborador bancario <span class="required-mark" aria-hidden="true">*</span></label><input asp-for="Input.CollaboratorId" class="form-control" required aria-required="true"/><div class="form-text">Identificador usado por el archivo bancario. WinForms exige contenido, pero no lo valida contra SAP.</div><span asp-validation-for="Input.CollaboratorId" class="invalid-feedback d-block"></span></div>
  <div class="col-md-4"><label asp-for="Input.LedgerAccount"></label><input asp-for="Input.LedgerAccount" class="form-control" maxlength="15" aria-describedby="ledger-help"/><div id="ledger-help" class="form-text">Opcional. Si se indica, debe existir en OACT de SAP.</div><span asp-validation-for="Input.LedgerAccount" class="invalid-feedback d-block"></span></div>
  <div class="col-md-8"><label for="Photo">Fotografía</label><input asp-for="Photo" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" aria-describedby="photo-help"/><div id="photo-help" class="form-text">JPG, PNG o WEBP real; máximo 5 MB. Seleccione otra para reemplazarla.</div><span asp-validation-for="Photo" class="invalid-feedback d-block"></span></div>
  <div class="col-md-4"><div class="employee-photo-preview">@if(Model.HasPhoto){<img id="photo-preview" src="@Url.Page("Edit","Photo",new{id=Model.OriginalIdentification})" alt="Fotografía del empleado"/><div id="photo-empty" class="employee-photo-empty" hidden>Sin fotografía almacenada</div>}else{<img id="photo-preview" src="" alt="Fotografía del empleado" hidden/><div id="photo-empty" class="employee-photo-empty">Sin fotografía almacenada</div>}</div></div>
  <div class="col-12"><div class="alert alert-light border"><strong>Saldos de vacaciones (solo consulta en Fase A)</strong><div>Ganadas: @Model.Input.VacationEarned · Consumidas: @Model.Input.VacationUsed · Pendientes: @Model.Input.VacationPending</div></div></div>
 </div>
 <div asp-validation-summary="All" class="alert alert-danger mt-3" role="alert"></div>
 <div class="mt-4"><button class="btn btn-primary">Guardar empleado</button> <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>@if(!Model.IsNew){<button type="submit" asp-page-handler="Deactivate" class="btn btn-outline-danger float-end" formnovalidate onclick="return confirm('¿Está seguro que desea inactivar al empleado? Podrá reactivarlo después mediante un nuevo ciclo laboral.');">Inactivar empleado</button>}</div>
</form>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>(()=>{const position=document.getElementById('Input_Position'),route=document.getElementById('employee-route'),routeRequired=document.getElementById('route-required'),salary=document.getElementById('employee-salary'),fortnight=document.getElementById('fortnight-salary'),daily=document.getElementById('daily-salary'),input=document.getElementById('Photo'),preview=document.getElementById('photo-preview'),empty=document.getElementById('photo-empty');function syncRoute(){const agent=position?.value.toUpperCase()==='AGENTE';if(route){route.readOnly=!agent;route.required=agent;route.setAttribute('aria-required',String(agent));if(!agent)route.value='0';}if(routeRequired)routeRequired.hidden=!agent;}function syncSalary(){const value=Number(salary?.value||0);fortnight.textContent=(value/2).toLocaleString('es-CR',{minimumFractionDigits:2});daily.textContent=(value/30).toLocaleString('es-CR',{minimumFractionDigits:2});}function showEmpty(){if(preview)preview.hidden=true;if(empty)empty.hidden=false;}if(preview){preview.addEventListener('load',()=>{preview.hidden=false;if(empty)empty.hidden=true;});preview.addEventListener('error',showEmpty);if(!preview.getAttribute('src'))showEmpty();}input?.addEventListener('change',()=>{const file=input.files?.[0];if(!file)return;if(preview){preview.src=URL.createObjectURL(file);preview.hidden=false;}if(empty)empty.hidden=true;});position?.addEventListener('change',syncRoute);salary?.addEventListener('input',syncSalary);syncRoute();syncSalary();})();</script>}
