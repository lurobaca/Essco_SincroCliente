@page "{id}"
@model Essco.Web.Pages.Employees.BackgroundModel
@{
    ViewData["Title"] = "Experiencia y educación";
    var employeeId = RouteData.Values["id"];
}

<a asp-page="Detail" asp-route-id="@employeeId">← Volver al expediente</a>
<h1>Experiencia y educación</h1>
<p class="text-muted">@Model.EmployeeName</p>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info" role="status">@Model.StatusMessage</div>
}

<!-- Las pestañas conservan el orden de Experiencia y Educación del formulario WinForms. -->
<ul class="nav nav-tabs mb-4" id="employeeBackgroundTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.SelectedSection == "experience" ? "active" : "")" id="experience-tab" data-bs-toggle="tab" data-bs-target="#experience-pane" type="button" role="tab" aria-controls="experience-pane" aria-selected="@(Model.SelectedSection == "experience")">Experiencia</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.SelectedSection == "education" ? "active" : "")" id="education-tab" data-bs-toggle="tab" data-bs-target="#education-pane" type="button" role="tab" aria-controls="education-pane" aria-selected="@(Model.SelectedSection == "education")">Educación</button>
    </li>
</ul>

<div class="tab-content">
    <!-- Consulta y mantenimiento de experiencia laboral previa. -->
    <section class="tab-pane fade @(Model.SelectedSection == "experience" ? "show active" : "")" id="experience-pane" role="tabpanel" aria-labelledby="experience-tab" tabindex="0">
        <h2 class="h4">Experiencia laboral</h2>
        @if (Model.EditingExperienceKey is not null)
        {
            <div class="alert alert-info">Editando la experiencia seleccionada. La cédula de empresa identifica el registro y no se puede cambiar aquí.</div>
        }

        <form method="post" asp-page-handler="@(Model.EditingExperienceKey is null ? "Experience" : "UpdateExperience")">
            @if (Model.EditingExperienceKey is not null)
            {
                <input type="hidden" name="key" value="@Model.EditingExperienceKey" />
            }

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="ExperienceInput.CompanyId" class="form-label">Cédula de empresa</label>
                    <input asp-for="ExperienceInput.CompanyId" class="form-control" readonly="@(Model.EditingExperienceKey is not null)" />
                </div>
                <div class="col-md-8">
                    <label asp-for="ExperienceInput.Company" class="form-label">Empresa</label>
                    <input asp-for="ExperienceInput.Company" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ExperienceInput.Position" class="form-label">Puesto</label>
                    <input asp-for="ExperienceInput.Position" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="ExperienceInput.From" class="form-label">Fecha de ingreso</label>
                    <input asp-for="ExperienceInput.From" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="ExperienceInput.To" class="form-label">Fecha de salida</label>
                    <input asp-for="ExperienceInput.To" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ExperienceInput.Reference" class="form-label">Persona de referencia</label>
                    <input asp-for="ExperienceInput.Reference" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ExperienceInput.Phone" class="form-label">Teléfono</label>
                    <input asp-for="ExperienceInput.Phone" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="ExperienceInput.Comments" class="form-label">Comentarios</label>
                    <textarea asp-for="ExperienceInput.Comments" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <button class="btn btn-primary mt-3" type="submit">@(Model.EditingExperienceKey is null ? "Agregar experiencia" : "Actualizar experiencia")</button>
            @if (Model.EditingExperienceKey is not null)
            {
                <a asp-page="Background" asp-route-id="@employeeId" class="btn btn-outline-secondary mt-3">Cancelar edición</a>
            }
        </form>

        <div class="table-responsive mt-4">
            <table class="table">
                <thead><tr><th>Empresa</th><th>Puesto</th><th>Periodo</th><th>Acciones</th></tr></thead>
                <tbody>
                    @foreach (var experience in Model.Experience)
                    {
                        <tr>
                            <td>@experience.Company</td>
                            <td>@experience.Position</td>
                            <td>@experience.From — @experience.To</td>
                            <td>
                                <a asp-page="Background" asp-route-id="@employeeId" asp-route-experience="@experience.CompanyId" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form method="post" asp-page-handler="DeleteExperience" class="d-inline">
                                    <input type="hidden" name="key" value="@experience.CompanyId" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Consulta y alta de educación; la edición sigue pendiente de migración. -->
    <section class="tab-pane fade @(Model.SelectedSection == "education" ? "show active" : "")" id="education-pane" role="tabpanel" aria-labelledby="education-tab" tabindex="0">
        <h2 class="h4">Educación</h2>
        <div class="alert alert-info">La edición de estudios aún está pendiente. Las acciones disponibles son agregar y eliminar.</div>

        <form method="post" asp-page-handler="Education">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="EducationInput.Institution" class="form-label">Institución</label>
                    <input asp-for="EducationInput.Institution" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="EducationInput.Title" class="form-label">Título</label>
                    <input asp-for="EducationInput.Title" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="EducationInput.Degree" class="form-label">Grado</label>
                    <input asp-for="EducationInput.Degree" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="EducationInput.From" class="form-label">Fecha de ingreso</label>
                    <input asp-for="EducationInput.From" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="EducationInput.To" class="form-label">Fecha de salida</label>
                    <input asp-for="EducationInput.To" type="date" class="form-control" />
                </div>
                <div class="col-12 form-check ms-2">
                    <input asp-for="EducationInput.InProgress" class="form-check-input" />
                    <label asp-for="EducationInput.InProgress" class="form-check-label">En curso</label>
                </div>
            </div>
            <button class="btn btn-primary mt-3" type="submit">Agregar estudio</button>
        </form>

        <div class="table-responsive mt-4">
            <table class="table">
                <thead><tr><th>Institución</th><th>Título</th><th>Grado</th><th>Acción</th></tr></thead>
                <tbody>
                    @foreach (var education in Model.Education)
                    {
                        <tr>
                            <td>@education.Institution</td>
                            <td>@education.Title</td>
                            <td>@education.Degree</td>
                            <td>
                                <form method="post" asp-page-handler="DeleteEducation">
                                    <input type="hidden" name="key" value="@education.Institution" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
