@page "{id}"
@model Essco.Web.Pages.Employees.DetailModel
@{
    ViewData["Title"] = "Expediente";
    var employee = Model.File.Employee;
    var attachmentCount = Model.File.Vacations.Count + Model.File.Disabilities.Count + Model.File.Loans.Count;
    var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    var selectedExperience = Model.SelectedExperience;
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="toast-container employee-notification" aria-live="polite" aria-atomic="true">
        <div id="employee-operation-toast" class="toast border-0 @(Model.OperationSucceeded == true ? "text-bg-primary" : "text-bg-danger")" role="status" data-bs-autohide="true" data-bs-delay="4500">
            <div class="d-flex align-items-center">
                <div class="toast-body">@Model.StatusMessage</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar aviso"></button>
            </div>
        </div>
    </div>
}

<main class="employee-profile">
    <a class="employee-back-link" asp-page="Index">← Volver a empleados</a>
    @if (!string.IsNullOrWhiteSpace(Model.Notice) && Model.SelectedSection == "overview")
    {
        <div class="alert alert-warning" role="status">@Model.Notice</div>
    }

    <header class="employee-profile__header">
        <div class="employee-photo-preview" style="width:180px">
            <img src="@Url.Page("Detail","Photo",new{id=employee.Identification})" alt="Fotografía de @employee.Name" onerror="this.hidden=true;this.nextElementSibling.hidden=false" />
            <div class="employee-photo-empty" hidden>Sin fotografía almacenada</div>
        </div>
        <div>
            <span class="employee-profile__eyebrow">Expediente del colaborador</span>
            <h1>@employee.Name</h1>
            <div class="employee-profile__identity">
                <span>@employee.Identification</span>
                @if (!string.IsNullOrWhiteSpace(employee.Position))
                {
                    <span>@employee.Position</span>
                }
                @if (!string.IsNullOrWhiteSpace(employee.Email))
                {
                    <a href="mailto:@employee.Email">@employee.Email</a>
                }
            </div>
            <span class="badge @(employee.Active ? "text-bg-success" : "text-bg-secondary")">@employee.StatusName</span>
        </div>
        <div class="employee-profile__actions">
            @if (Model.CanManage && employee.CanEdit)
            {
                <a class="btn btn-primary" asp-page="Edit" asp-route-id="@employee.Identification">Editar datos</a>
                <form method="post" asp-page="Edit" asp-page-handler="Deactivate">
                    <input type="hidden" name="OriginalIdentification" value="@employee.Identification" />
                    <button class="btn btn-outline-danger" onclick="return confirm('¿Está seguro que desea inactivar al empleado? Podrá reactivarlo después mediante un nuevo ciclo laboral.');">Inactivar empleado</button>
                </form>
            }
            else if (Model.CanManage && employee.StatusCode == 1)
            {
                <form method="post" asp-page="Edit" asp-page-handler="Reactivate" class="border rounded p-3">
                    <input type="hidden" name="OriginalIdentification" value="@employee.Identification" />
                    <label for="reactivation-date" class="form-label"><strong>Nueva fecha de ingreso</strong></label>
                    <input id="reactivation-date" name="reactivationDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control mb-2" required />
                    <button class="btn btn-primary" onclick="return confirm('Se iniciará un nuevo ciclo laboral. Se inactivarán los movimientos anteriores, se reiniciarán vacaciones y se retirará al empleado de planillas abiertas. ¿Desea continuar?');">Reactivar empleado</button>
                    <div class="form-text">Educación, experiencia, datos personales y planillas finalizadas se conservarán.</div>
                </form>
            }
            else if (!employee.Active)
            {
                <span class="text-muted">Los estados cerrado y liquidado son de solo consulta.</span>
            }
        </div>
    </header>

    <section class="employee-stat-grid" aria-label="Resumen del expediente">
        <article class="employee-stat-card">
            <span>Salario actual</span>
            <strong>₡@employee.Salary.ToString("N2")</strong>
        </article>
        <article class="employee-stat-card">
            <span>Vacaciones ganadas</span>
            <strong>@employee.VacationEarned</strong>
        </article>
        <article class="employee-stat-card">
            <span>Vacaciones consumidas</span>
            <strong>@employee.VacationUsed</strong>
        </article>
        <article class="employee-stat-card employee-stat-card--accent">
            <span>Vacaciones pendientes</span>
            <strong>@employee.VacationPending</strong>
        </article>
    </section>

    <div class="alert alert-info"><strong>Expediente en migración.</strong> Las pestañas siguen el orden del formulario original. Las operaciones disponibles se enlazan desde su pestaña; las demás se identifican como pendientes.</div>

    <section class="employee-file-card">
        <ul class="nav nav-tabs employee-tabs" id="employeeFileTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.SelectedSection == "overview" ? "active" : "")" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-pane" type="button" role="tab" aria-controls="overview-pane" aria-selected="@(Model.SelectedSection == "overview")">Resumen</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.SelectedSection == "experience" ? "active" : "")" id="experience-tab" data-bs-toggle="tab" data-bs-target="#experience-pane" type="button" role="tab" aria-controls="experience-pane" aria-selected="@(Model.SelectedSection == "experience")">Experiencia</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.SelectedSection == "education" ? "active" : "")" id="education-tab" data-bs-toggle="tab" data-bs-target="#education-pane" type="button" role="tab" aria-controls="education-pane" aria-selected="@(Model.SelectedSection == "education")">Educación</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.SelectedSection == "vacations" ? "active" : "")" id="vacations-tab" data-bs-toggle="tab" data-bs-target="#vacations-pane" type="button" role="tab" aria-controls="vacations-pane" aria-selected="@(Model.SelectedSection == "vacations")">Vacaciones <span class="badge">@Model.File.Vacations.Count</span></button>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link @(Model.SelectedSection == "invoices" ? "active" : "")" id="invoices-tab" asp-page="Detail" asp-route-id="@employee.Identification" asp-route-section="invoices" asp-fragment="invoices-pane" role="tab" aria-controls="invoices-pane" aria-selected="@(Model.SelectedSection == "invoices")">Facturas</a>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="loans-tab" data-bs-toggle="tab" data-bs-target="#loans-pane" type="button" role="tab" aria-controls="loans-pane" aria-selected="false">Vales y préstamos <span class="badge">@Model.File.Loans.Count</span></button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="deductions-tab" data-bs-toggle="tab" data-bs-target="#deductions-pane" type="button" role="tab" aria-controls="deductions-pane" aria-selected="false">Deducciones <span class="badge">@Model.File.Deductions.Count</span></button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="disabilities-tab" data-bs-toggle="tab" data-bs-target="#disabilities-pane" type="button" role="tab" aria-controls="disabilities-pane" aria-selected="false">Incapacidades <span class="badge">@Model.File.Disabilities.Count</span></button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="increases-tab" data-bs-toggle="tab" data-bs-target="#increases-pane" type="button" role="tab" aria-controls="increases-pane" aria-selected="false">Aumentos</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="payroll-tab" data-bs-toggle="tab" data-bs-target="#payroll-pane" type="button" role="tab" aria-controls="payroll-pane" aria-selected="false">Planillas</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="extra-days-tab" data-bs-toggle="tab" data-bs-target="#extra-days-pane" type="button" role="tab" aria-controls="extra-days-pane" aria-selected="false">Días adicionales</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="settlement-tab" data-bs-toggle="tab" data-bs-target="#settlement-pane" type="button" role="tab" aria-controls="settlement-pane" aria-selected="false">Liquidación laboral</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="additionals-tab" data-bs-toggle="tab" data-bs-target="#additionals-pane" type="button" role="tab" aria-controls="additionals-pane" aria-selected="false">Adicionales</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="attachments-tab" data-bs-toggle="tab" data-bs-target="#attachments-pane" type="button" role="tab" aria-controls="attachments-pane" aria-selected="false">Adjuntos <span class="badge">@attachmentCount</span></button>
            </li>
        </ul>

        <div class="tab-content employee-tab-content" id="employeeFileTabContent">
            <div class="tab-pane fade @(Model.SelectedSection == "overview" ? "show active" : "")" id="overview-pane" role="tabpanel" aria-labelledby="overview-tab" tabindex="0">
                <div class="employee-overview-grid">
                    <article>
                        <span>Identificación</span>
                        <strong>@employee.Identification</strong>
                    </article>
                    <article>
                        <span>Puesto</span>
                        <strong>@(string.IsNullOrWhiteSpace(employee.Position) ? "Sin asignar" : employee.Position)</strong>
                    </article>
                    <article>
                        <span>Correo electrónico</span>
                        <strong>@(string.IsNullOrWhiteSpace(employee.Email) ? "Sin registrar" : employee.Email)</strong>
                    </article>
                </div>
                <div class="employee-empty-state employee-empty-state--compact">
                    <strong>Expediente centralizado</strong>
                    <p>Selecciona una pestaña para consultar las áreas del expediente en el orden del sistema original.</p>
                </div>
            </div>

            <!-- La experiencia se consulta y mantiene directamente en el expediente. -->
            <div class="tab-pane fade @(Model.SelectedSection == "experience" ? "show active" : "")" id="experience-pane" role="tabpanel" aria-labelledby="experience-tab" tabindex="0">
                <h2 class="h4">Experiencia laboral</h2>
                @if (!Model.CanViewBackground)
                {
                    <p class="text-muted">No tiene permiso para consultar la experiencia laboral.</p>
                }
                else
                {
                    @if (selectedExperience is not null)
                    {
                        <div class="alert alert-info">Editando la experiencia seleccionada. La cédula de empresa identifica el registro y no se puede cambiar aquí.</div>
                    }
                    <form method="post" asp-page="Background" asp-page-handler="@(selectedExperience is null ? "Experience" : "UpdateExperience")" asp-route-id="@employee.Identification">
                        <input type="hidden" name="returnToDetail" value="true" />
                        @if (selectedExperience is not null)
                        {
                            <input type="hidden" name="key" value="@selectedExperience.CompanyId" />
                        }
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="experience-company-id" class="form-label">Cédula de empresa</label>
                                <input id="experience-company-id" name="ExperienceInput.CompanyId" value="@selectedExperience?.CompanyId" class="form-control" readonly="@(selectedExperience is not null)" />
                            </div>
                            <div class="col-md-8">
                                <label for="experience-company" class="form-label">Empresa</label>
                                <input id="experience-company" name="ExperienceInput.Company" value="@selectedExperience?.Company" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label for="experience-position" class="form-label">Puesto</label>
                                <input id="experience-position" name="ExperienceInput.Position" value="@selectedExperience?.Position" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label for="experience-from" class="form-label">Fecha de ingreso</label>
                                <input id="experience-from" name="ExperienceInput.From" type="date" value="@(selectedExperience?.From.ToString("yyyy-MM-dd") ?? today)" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label for="experience-to" class="form-label">Fecha de salida</label>
                                <input id="experience-to" name="ExperienceInput.To" type="date" value="@(selectedExperience?.To.ToString("yyyy-MM-dd") ?? today)" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label for="experience-reference" class="form-label">Persona de referencia</label>
                                <input id="experience-reference" name="ExperienceInput.Reference" value="@selectedExperience?.Reference" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label for="experience-phone" class="form-label">Teléfono</label>
                                <input id="experience-phone" name="ExperienceInput.Phone" value="@selectedExperience?.Phone" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label for="experience-comments" class="form-label">Comentarios</label>
                                <textarea id="experience-comments" name="ExperienceInput.Comments" class="form-control" rows="3">@selectedExperience?.Comments</textarea>
                            </div>
                        </div>
                        <button class="btn btn-primary mt-3" type="submit">@(selectedExperience is null ? "Agregar experiencia" : "Actualizar experiencia")</button>
                        @if (selectedExperience is not null)
                        {
                            <a asp-page="Detail" asp-route-id="@employee.Identification" asp-route-section="experience" asp-fragment="experience-pane" class="btn btn-outline-secondary mt-3">Cancelar edición</a>
                        }
                    </form>
                    <div class="table-responsive mt-4">
                        <table class="table">
                            <thead><tr><th>Empresa</th><th>Puesto</th><th>Periodo</th><th>Acciones</th></tr></thead>
                            <tbody>
                                @foreach (var experience in Model.Experience)
                                {
                                    <tr>
                                        <td>@experience.Company</td>
                                        <td>@experience.Position</td>
                                        <td>@experience.From — @experience.To</td>
                                        <td>
                                            <a asp-page="Detail" asp-route-id="@employee.Identification" asp-route-section="experience" asp-route-experience="@experience.CompanyId" asp-fragment="experience-pane" class="btn btn-sm btn-outline-primary">Editar</a>
                                            <form method="post" asp-page="Background" asp-page-handler="DeleteExperience" asp-route-id="@employee.Identification" class="d-inline">
                                                <input type="hidden" name="returnToDetail" value="true" />
                                                <input type="hidden" name="key" value="@experience.CompanyId" />
                                                <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('¿Eliminar esta experiencia?');">Eliminar</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- La educación usa las mismas operaciones existentes, sin salir del expediente. -->
            <div class="tab-pane fade @(Model.SelectedSection == "education" ? "show active" : "")" id="education-pane" role="tabpanel" aria-labelledby="education-tab" tabindex="0">
                <h2 class="h4">Educación</h2>
                @if (!Model.CanViewBackground)
                {
                    <p class="text-muted">No tiene permiso para consultar la educación del empleado.</p>
                }
                else
                {
                    <p class="text-muted">Por ahora puede agregar y eliminar estudios; la edición sigue pendiente de migración.</p>
                    <form method="post" asp-page="Background" asp-page-handler="Education" asp-route-id="@employee.Identification">
                        <input type="hidden" name="returnToDetail" value="true" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="education-institution" class="form-label">Institución</label>
                                <input id="education-institution" name="EducationInput.Institution" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label for="education-title" class="form-label">Título</label>
                                <input id="education-title" name="EducationInput.Title" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label for="education-degree" class="form-label">Grado</label>
                                <input id="education-degree" name="EducationInput.Degree" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label for="education-from" class="form-label">Fecha de ingreso</label>
                                <input id="education-from" name="EducationInput.From" type="date" value="@today" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label for="education-to" class="form-label">Fecha de salida</label>
                                <input id="education-to" name="EducationInput.To" type="date" value="@today" class="form-control" />
                            </div>
                            <div class="col-12 form-check ms-2">
                                <input id="education-in-progress" name="EducationInput.InProgress" type="checkbox" value="true" class="form-check-input" />
                                <label for="education-in-progress" class="form-check-label">En curso</label>
                            </div>
                        </div>
                        <button class="btn btn-primary mt-3" type="submit">Agregar estudio</button>
                    </form>
                    <div class="table-responsive mt-4">
                        <table class="table">
                            <thead><tr><th>Institución</th><th>Título</th><th>Grado</th><th>Acción</th></tr></thead>
                            <tbody>
                                @foreach (var education in Model.Education)
                                {
                                    <tr>
                                        <td>@education.Institution</td>
                                        <td>@education.Title</td>
                                        <td>@education.Degree</td>
                                        <td>
                                            <form method="post" asp-page="Background" asp-page-handler="DeleteEducation" asp-route-id="@employee.Identification">
                                                <input type="hidden" name="returnToDetail" value="true" />
                                                <input type="hidden" name="key" value="@education.Institution" />
                                                <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('¿Eliminar este estudio?');">Eliminar</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="tab-pane fade @(Model.SelectedSection == "invoices" ? "show active" : "")" id="invoices-pane" role="tabpanel" aria-labelledby="invoices-tab" tabindex="0">
                <h2 class="h4">Facturas pendientes del empleado</h2>
                @if (!Model.CanViewBackground)
                {
                    <p class="text-muted">No tiene permiso para consultar las facturas del empleado.</p>
                }
                else if (string.IsNullOrWhiteSpace(employee.Code))
                {
                    <p class="text-muted">El empleado no tiene un código de cliente SAP asociado.</p>
                }
                else if (Model.InvoiceQueryFailed)
                {
                    <div class="alert alert-danger" role="alert">No se pudieron consultar las facturas pendientes. Revise la conexión SQL y la función FacturaPendiente.</div>
                }
                else if (Model.PendingInvoices is null)
                {
                    <p class="text-muted">Abra esta pestaña para consultar las facturas pendientes.</p>
                }
                else if (Model.PendingInvoices.Rows.Count == 0)
                {
                    <div class="employee-empty-state"><strong>Sin facturas pendientes</strong><p>No se encontraron facturas para el código @employee.Code.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table employee-data-table">
                            <thead>
                                <tr>
                                    @foreach (var column in Model.PendingInvoices.Columns)
                                    {
                                        <th scope="col">@column</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var invoice in Model.PendingInvoices.Rows)
                                {
                                    <tr>
                                        @foreach (var value in invoice)
                                        {
                                            <td>@value</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="text-end"><strong>Total pendiente: ₡@Model.PendingInvoices.TotalBalance.ToString("N2")</strong></p>
                }
            </div>

            <div class="tab-pane fade @(Model.SelectedSection == "vacations" ? "show active" : "")" id="vacations-pane" role="tabpanel" aria-labelledby="vacations-tab" tabindex="0">
                <h2 class="h4">Vacaciones</h2>
                @if (Model.CanViewBackground && employee.Active)
                {
                    <p class="text-muted">Registro parcial: aún falta migrar el cálculo automático de días y saldos del sistema anterior. Verifique estos valores antes de guardar.</p>
                    <form method="post" asp-page="Movements" asp-page-handler="Vacation" asp-route-id="@employee.Identification" class="mb-4">
                        <input type="hidden" name="returnToDetail" value="true" />
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label for="vacation-from" class="form-label">Fecha inicial</label>
                                <input id="vacation-from" name="Vacation.From" type="date" value="@today" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label for="vacation-to" class="form-label">Fecha final</label>
                                <input id="vacation-to" name="Vacation.To" type="date" value="@today" class="form-control" required />
                            </div>
                            <div class="col-md-2">
                                <label for="vacation-days" class="form-label">Días a consumir</label>
                                <input id="vacation-days" name="Vacation.Days" type="number" min="0.01" step="0.01" value="1" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label for="vacation-comments" class="form-label">Comentario</label>
                                <input id="vacation-comments" name="Vacation.Comments" class="form-control" />
                            </div>
                        </div>
                        <button class="btn btn-primary mt-3" type="submit">Registrar vacaciones</button>
                    </form>
                }
                else if (!Model.CanViewBackground)
                {
                    <p class="text-muted">No tiene permiso para registrar movimientos de vacaciones.</p>
                }
                @if (Model.File.Vacations.Count == 0)
                {
                    <div class="employee-empty-state"><strong>Sin vacaciones registradas</strong><p>Los movimientos de vacaciones del colaborador aparecerán aquí.</p></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table employee-data-table"><thead><tr><th>Periodo</th><th>Días</th><th>Comentario</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
                    @foreach (var item in Model.File.Vacations)
                    {
                        <tr>
                            <td>@item.From — @item.To</td>
                            <td>@item.Days</td>
                            <td>@item.Comments</td>
                            <td><span class="employee-status @(item.Annulled ? "employee-status--inactive" : "employee-status--active")">@(item.Annulled ? "Anulada" : "Activa")</span></td>
                            <td>
                                @if (Model.CanViewBackground && employee.Active && !item.Annulled)
                                {
                                    <form method="post" asp-page="Movements" asp-page-handler="Annul" asp-route-id="@employee.Identification">
                                        <input type="hidden" name="returnToDetail" value="true" />
                                        <input type="hidden" name="type" value="vacation" />
                                        <input type="hidden" name="number" value="@item.Number" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('¿Anular este movimiento de vacaciones?');">Anular</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody></table></div>
                }
            </div>

            <div class="tab-pane fade" id="disabilities-pane" role="tabpanel" aria-labelledby="disabilities-tab" tabindex="0">
                <p><a asp-page="Movements" asp-route-id="@employee.Identification" class="btn btn-outline-primary">Registrar o anular incapacidad</a></p>
                @if (Model.File.Disabilities.Count == 0)
                {
                    <div class="employee-empty-state"><strong>Sin incapacidades registradas</strong><p>Los periodos de incapacidad aparecerán aquí.</p></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table employee-data-table"><thead><tr><th>Periodo</th><th>Días</th><th>Tipo / comprobante</th><th>Detalle</th></tr></thead><tbody>
                    @foreach (var item in Model.File.Disabilities)
                    {
                        <tr><td>@item.From — @item.To</td><td>@item.Days</td><td>@item.Type / @item.Voucher</td><td>@item.Detail</td></tr>
                    }
                    </tbody></table></div>
                }
            </div>

            <div class="tab-pane fade" id="deductions-pane" role="tabpanel" aria-labelledby="deductions-tab" tabindex="0">
                <p><a asp-page="Movements" asp-route-id="@employee.Identification" class="btn btn-outline-primary">Registrar o anular deducción</a></p>
                @if (Model.File.Deductions.Count == 0)
                {
                    <div class="employee-empty-state"><strong>Sin deducciones registradas</strong><p>Las deducciones recurrentes o extraordinarias aparecerán aquí.</p></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table employee-data-table"><thead><tr><th>Categoría</th><th>Monto</th><th>Detalle</th><th>Distribución quincenal</th></tr></thead><tbody>
                    @foreach (var item in Model.File.Deductions)
                    {
                        <tr><td>@item.Category</td><td>₡@item.Amount.ToString("N2")</td><td>@item.Detail</td><td>@item.FirstFortnightPercentage% / @item.SecondFortnightPercentage%</td></tr>
                    }
                    </tbody></table></div>
                }
            </div>

            <div class="tab-pane fade" id="loans-pane" role="tabpanel" aria-labelledby="loans-tab" tabindex="0">
                <p><a asp-page="Movements" asp-route-id="@employee.Identification" class="btn btn-outline-primary">Registrar o anular vale/préstamo</a></p>
                @if (Model.File.Loans.Count == 0)
                {
                    <div class="employee-empty-state"><strong>Sin vales ni préstamos registrados</strong><p>Los saldos, cuotas y detalles de financiamiento aparecerán aquí.</p></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table employee-data-table"><thead><tr><th>Tipo</th><th>Monto</th><th>Saldo</th><th>Cuota</th><th>Detalle</th></tr></thead><tbody>
                    @foreach (var item in Model.File.Loans)
                    {
                        <tr><td>@item.Type</td><td>₡@item.Amount.ToString("N2")</td><td>₡@item.Balance.ToString("N2")</td><td>₡@item.FortnightPayment.ToString("N2")</td><td>@item.Detail</td></tr>
                    }
                    </tbody></table></div>
                }
            </div>

            <div class="tab-pane fade" id="attachments-pane" role="tabpanel" aria-labelledby="attachments-tab" tabindex="0">
                @if (attachmentCount == 0)
                {
                    <div class="employee-empty-state"><strong>Sin documentos adjuntos</strong><p>Cuando un movimiento tenga respaldo documental, podrás consultarlo desde aquí.</p></div>
                }
                else
                {
                    <div class="employee-attachment-list">
                        @foreach (var item in Model.File.Vacations)
                        {
                            <a asp-page="Attachment" asp-route-id="@employee.Identification" asp-route-kind="vacation" asp-route-number="@item.Number"><span>Vacación</span><strong>Movimiento @item.Number</strong></a>
                        }
                        @foreach (var item in Model.File.Disabilities)
                        {
                            <a asp-page="Attachment" asp-route-id="@employee.Identification" asp-route-kind="disability" asp-route-number="@item.Number"><span>Incapacidad</span><strong>Movimiento @item.Number</strong></a>
                        }
                        @foreach (var item in Model.File.Loans)
                        {
                            <a asp-page="Attachment" asp-route-id="@employee.Identification" asp-route-kind="loan" asp-route-number="@item.Number"><span>Vale o préstamo</span><strong>Movimiento @item.Number</strong></a>
                        }
                    </div>
                }
            </div>

            <!-- Las siguientes áreas permanecen explícitamente parciales o sin migrar. -->
            <div class="tab-pane fade" id="increases-pane" role="tabpanel" aria-labelledby="increases-tab" tabindex="0">
                <h2 class="h4">Aumentos</h2>
                <p>El registro y el historial de aumentos están disponibles en el mantenimiento parcial de compensación.</p>
                <a asp-page="Compensation" asp-route-id="@employee.Identification" class="btn btn-primary">Abrir aumentos</a>
            </div>

            <div class="tab-pane fade" id="payroll-pane" role="tabpanel" aria-labelledby="payroll-tab" tabindex="0">
                <div class="employee-empty-state"><strong>Historial de planillas pendiente</strong><p>Aún falta la consulta contextual y los promedios del empleado.</p></div>
            </div>

            <div class="tab-pane fade" id="extra-days-pane" role="tabpanel" aria-labelledby="extra-days-tab" tabindex="0">
                <div class="employee-empty-state"><strong>Días adicionales pendientes</strong><p>El ciclo de registro y cálculo de esta pestaña todavía no está migrado.</p></div>
            </div>

            <div class="tab-pane fade" id="settlement-pane" role="tabpanel" aria-labelledby="settlement-tab" tabindex="0">
                <div class="employee-empty-state"><strong>Liquidación laboral pendiente</strong><p>El cálculo y cierre del ciclo laboral deben validarse antes de habilitar acciones.</p></div>
            </div>

            <div class="tab-pane fade" id="additionals-pane" role="tabpanel" aria-labelledby="additionals-tab" tabindex="0">
                <h2 class="h4">Adicionales</h2>
                <p>El registro y la consulta parcial de adicionales están disponibles en compensación.</p>
                <a asp-page="Compensation" asp-route-id="@employee.Identification" class="btn btn-primary">Abrir adicionales</a>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script>
        // Muestra el resultado de la operación sin ocupar espacio permanente en el formulario.
        const operationToast = document.getElementById("employee-operation-toast");
        if (operationToast) {
            bootstrap.Toast.getOrCreateInstance(operationToast).show();
        }
    </script>
}
