@page "{id}"
@model Essco.Web.Pages.Employees.DetailModel
@{
    ViewData["Title"] = "Expediente";
    var employee = Model.File.Employee;
    var attachmentCount = Model.File.Vacations.Count + Model.File.Disabilities.Count + Model.File.Loans.Count;
}

<main class="employee-profile">
    <a class="employee-back-link" asp-page="Index">← Volver a empleados</a>
    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="alert alert-warning" role="status">@Model.Notice</div>
    }

    <header class="employee-profile__header">
        <div class="employee-photo-preview" style="width:180px">
            <img src="@Url.Page("Detail","Photo",new{id=employee.Identification})" alt="Fotografía de @employee.Name" onerror="this.hidden=true;this.nextElementSibling.hidden=false" />
            <div class="employee-photo-empty" hidden>Sin fotografía almacenada</div>
        </div>
        <div>
            <span class="employee-profile__eyebrow">Expediente del colaborador</span>
            <h1>@employee.Name</h1>
            <div class="employee-profile__identity">
                <span>@employee.Identification</span>
                @if (!string.IsNullOrWhiteSpace(employee.Position))
                {
                    <span>@employee.Position</span>
                }
                @if (!string.IsNullOrWhiteSpace(employee.Email))
                {
                    <a href="mailto:@employee.Email">@employee.Email</a>
                }
            </div>
            <span class="badge @(employee.Active ? "text-bg-success" : "text-bg-secondary")">@employee.StatusName</span>
        </div>
        <div class="employee-profile__actions">
            @if (Model.CanManage && employee.CanEdit)
            {
                <a class="btn btn-primary" asp-page="Edit" asp-route-id="@employee.Identification">Editar datos</a>
                <form method="post" asp-page="Edit" asp-page-handler="Deactivate">
                    <input type="hidden" name="OriginalIdentification" value="@employee.Identification" />
                    <button class="btn btn-outline-danger" onclick="return confirm('¿Está seguro que desea inactivar al empleado? Podrá reactivarlo después mediante un nuevo ciclo laboral.');">Inactivar empleado</button>
                </form>
            }
            else if (Model.CanManage && employee.StatusCode == 1)
            {
                <form method="post" asp-page="Edit" asp-page-handler="Reactivate" class="border rounded p-3">
                    <input type="hidden" name="OriginalIdentification" value="@employee.Identification" />
                    <label for="reactivation-date" class="form-label"><strong>Nueva fecha de ingreso</strong></label>
                    <input id="reactivation-date" name="reactivationDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control mb-2" required />
                    <button class="btn btn-primary" onclick="return confirm('Se iniciará un nuevo ciclo laboral. Se inactivarán los movimientos anteriores, se reiniciarán vacaciones y se retirará al empleado de planillas abiertas. ¿Desea continuar?');">Reactivar empleado</button>
                    <div class="form-text">Educación, experiencia, datos personales y planillas finalizadas se conservarán.</div>
                </form>
            }
            else if (!employee.Active)
            {
                <span class="text-muted">Los estados cerrado y liquidado son de solo consulta.</span>
            }
        </div>
    </header>

    <section class="employee-stat-grid" aria-label="Resumen del expediente">
        <article class="employee-stat-card">
            <span>Salario actual</span>
            <strong>₡@employee.Salary.ToString("N2")</strong>
        </article>
        <article class="employee-stat-card">
            <span>Vacaciones ganadas</span>
            <strong>@employee.VacationEarned</strong>
        </article>
        <article class="employee-stat-card">
            <span>Vacaciones consumidas</span>
            <strong>@employee.VacationUsed</strong>
        </article>
        <article class="employee-stat-card employee-stat-card--accent">
            <span>Vacaciones pendientes</span>
            <strong>@employee.VacationPending</strong>
        </article>
    </section>

    <div class="alert alert-info"><strong>Expediente en migración.</strong> Las pestañas siguen el orden del formulario original. Las operaciones disponibles se enlazan desde su pestaña; las demás se identifican como pendientes.</div>

    <section class="employee-file-card">
        <ul class="nav nav-tabs employee-tabs" id="employeeFileTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-pane" type="button" role="tab" aria-controls="overview-pane" aria-selected="true">Resumen</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="experience-tab" data-bs-toggle="tab" data-bs-target="#experience-pane" type="button" role="tab" aria-controls="experience-pane" aria-selected="false">Experiencia</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="education-tab" data-bs-toggle="tab" data-bs-target="#education-pane" type="button" role="tab" aria-controls="education-pane" aria-selected="false">Educación</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="vacations-tab" data-bs-toggle="tab" data-bs-target="#vacations-pane" type="button" role="tab" aria-controls="vacations-pane" aria-selected="false">Vacaciones <span class="badge">@Model.File.Vacations.Count</span></button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="invoices-tab" data-bs-toggle="tab" data-bs-target="#invoices-pane" type="button" role="tab" aria-controls="invoices-pane" aria-selected="false">Facturas</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="loans-tab" data-bs-toggle="tab" data-bs-target="#loans-pane" type="button" role="tab" aria-controls="loans-pane" aria-selected="false">Vales y préstamos <span class="badge">@Model.File.Loans.Count</span></button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="deductions-tab" data-bs-toggle="tab" data-bs-target="#deductions-pane" type="button" role="tab" aria-controls="deductions-pane" aria-selected="false">Deducciones <span class="badge">@Model.File.Deductions.Count</span></button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="disabilities-tab" data-bs-toggle="tab" data-bs-target="#disabilities-pane" type="button" role="tab" aria-controls="disabilities-pane" aria-selected="false">Incapacidades <span class="badge">@Model.File.Disabilities.Count</span></button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="increases-tab" data-bs-toggle="tab" data-bs-target="#increases-pane" type="button" role="tab" aria-controls="increases-pane" aria-selected="false">Aumentos</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="payroll-tab" data-bs-toggle="tab" data-bs-target="#payroll-pane" type="button" role="tab" aria-controls="payroll-pane" aria-selected="false">Planillas</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="extra-days-tab" data-bs-toggle="tab" data-bs-target="#extra-days-pane" type="button" role="tab" aria-controls="extra-days-pane" aria-selected="false">Días adicionales</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="settlement-tab" data-bs-toggle="tab" data-bs-target="#settlement-pane" type="button" role="tab" aria-controls="settlement-pane" aria-selected="false">Liquidación laboral</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="additionals-tab" data-bs-toggle="tab" data-bs-target="#additionals-pane" type="button" role="tab" aria-controls="additionals-pane" aria-selected="false">Adicionales</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="attachments-tab" data-bs-toggle="tab" data-bs-target="#attachments-pane" type="button" role="tab" aria-controls="attachments-pane" aria-selected="false">Adjuntos <span class="badge">@attachmentCount</span></button>
            </li>
        </ul>

        <div class="tab-content employee-tab-content" id="employeeFileTabContent">
            <div class="tab-pane fade show active" id="overview-pane" role="tabpanel" aria-labelledby="overview-tab" tabindex="0">
                <div class="employee-overview-grid">
                    <article>
                        <span>Identificación</span>
                        <strong>@employee.Identification</strong>
                    </article>
                    <article>
                        <span>Puesto</span>
                        <strong>@(string.IsNullOrWhiteSpace(employee.Position) ? "Sin asignar" : employee.Position)</strong>
                    </article>
                    <article>
                        <span>Correo electrónico</span>
                        <strong>@(string.IsNullOrWhiteSpace(employee.Email) ? "Sin registrar" : employee.Email)</strong>
                    </article>
                </div>
                <div class="employee-empty-state employee-empty-state--compact">
                    <strong>Expediente centralizado</strong>
                    <p>Selecciona una pestaña para consultar las áreas del expediente en el orden del sistema original.</p>
                </div>
            </div>

            <!-- Experiencia y educación conservan sus acciones actuales en una página de mantenimiento. -->
            <div class="tab-pane fade" id="experience-pane" role="tabpanel" aria-labelledby="experience-tab" tabindex="0">
                <h2 class="h4">Experiencia laboral</h2>
                <p>Consulta, agrega, actualiza y elimina experiencias registradas para este empleado.</p>
                <a asp-page="Background" asp-route-id="@employee.Identification" class="btn btn-primary">Abrir experiencia</a>
            </div>

            <div class="tab-pane fade" id="education-pane" role="tabpanel" aria-labelledby="education-tab" tabindex="0">
                <h2 class="h4">Educación</h2>
                <p>La consulta, el alta y la eliminación están disponibles. La edición de estudios sigue pendiente.</p>
                <a asp-page="Background" asp-route-id="@employee.Identification" asp-route-section="education" class="btn btn-primary">Abrir educación</a>
            </div>

            <div class="tab-pane fade" id="invoices-pane" role="tabpanel" aria-labelledby="invoices-tab" tabindex="0">
                <div class="employee-empty-state"><strong>Facturas del empleado pendientes</strong><p>Aún falta migrar la consulta de facturas vinculadas al código de cliente SAP del empleado.</p></div>
            </div>

            <div class="tab-pane fade" id="vacations-pane" role="tabpanel" aria-labelledby="vacations-tab" tabindex="0">
                <p><a asp-page="Movements" asp-route-id="@employee.Identification" class="btn btn-outline-primary">Registrar o anular vacaciones</a></p>
                @if (Model.File.Vacations.Count == 0)
                {
                    <div class="employee-empty-state"><strong>Sin vacaciones registradas</strong><p>Los movimientos de vacaciones del colaborador aparecerán aquí.</p></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table employee-data-table"><thead><tr><th>Periodo</th><th>Días</th><th>Comentario</th><th>Estado</th></tr></thead><tbody>
                    @foreach (var item in Model.File.Vacations)
                    {
                        <tr><td>@item.From — @item.To</td><td>@item.Days</td><td>@item.Comments</td><td><span class="employee-status @(item.Annulled ? "employee-status--inactive" : "employee-status--active")">@(item.Annulled ? "Anulada" : "Activa")</span></td></tr>
                    }
                    </tbody></table></div>
                }
            </div>

            <div class="tab-pane fade" id="disabilities-pane" role="tabpanel" aria-labelledby="disabilities-tab" tabindex="0">
                <p><a asp-page="Movements" asp-route-id="@employee.Identification" class="btn btn-outline-primary">Registrar o anular incapacidad</a></p>
                @if (Model.File.Disabilities.Count == 0)
                {
                    <div class="employee-empty-state"><strong>Sin incapacidades registradas</strong><p>Los periodos de incapacidad aparecerán aquí.</p></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table employee-data-table"><thead><tr><th>Periodo</th><th>Días</th><th>Tipo / comprobante</th><th>Detalle</th></tr></thead><tbody>
                    @foreach (var item in Model.File.Disabilities)
                    {
                        <tr><td>@item.From — @item.To</td><td>@item.Days</td><td>@item.Type / @item.Voucher</td><td>@item.Detail</td></tr>
                    }
                    </tbody></table></div>
                }
            </div>

            <div class="tab-pane fade" id="deductions-pane" role="tabpanel" aria-labelledby="deductions-tab" tabindex="0">
                <p><a asp-page="Movements" asp-route-id="@employee.Identification" class="btn btn-outline-primary">Registrar o anular deducción</a></p>
                @if (Model.File.Deductions.Count == 0)
                {
                    <div class="employee-empty-state"><strong>Sin deducciones registradas</strong><p>Las deducciones recurrentes o extraordinarias aparecerán aquí.</p></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table employee-data-table"><thead><tr><th>Categoría</th><th>Monto</th><th>Detalle</th><th>Distribución quincenal</th></tr></thead><tbody>
                    @foreach (var item in Model.File.Deductions)
                    {
                        <tr><td>@item.Category</td><td>₡@item.Amount.ToString("N2")</td><td>@item.Detail</td><td>@item.FirstFortnightPercentage% / @item.SecondFortnightPercentage%</td></tr>
                    }
                    </tbody></table></div>
                }
            </div>

            <div class="tab-pane fade" id="loans-pane" role="tabpanel" aria-labelledby="loans-tab" tabindex="0">
                <p><a asp-page="Movements" asp-route-id="@employee.Identification" class="btn btn-outline-primary">Registrar o anular vale/préstamo</a></p>
                @if (Model.File.Loans.Count == 0)
                {
                    <div class="employee-empty-state"><strong>Sin vales ni préstamos registrados</strong><p>Los saldos, cuotas y detalles de financiamiento aparecerán aquí.</p></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table employee-data-table"><thead><tr><th>Tipo</th><th>Monto</th><th>Saldo</th><th>Cuota</th><th>Detalle</th></tr></thead><tbody>
                    @foreach (var item in Model.File.Loans)
                    {
                        <tr><td>@item.Type</td><td>₡@item.Amount.ToString("N2")</td><td>₡@item.Balance.ToString("N2")</td><td>₡@item.FortnightPayment.ToString("N2")</td><td>@item.Detail</td></tr>
                    }
                    </tbody></table></div>
                }
            </div>

            <div class="tab-pane fade" id="attachments-pane" role="tabpanel" aria-labelledby="attachments-tab" tabindex="0">
                @if (attachmentCount == 0)
                {
                    <div class="employee-empty-state"><strong>Sin documentos adjuntos</strong><p>Cuando un movimiento tenga respaldo documental, podrás consultarlo desde aquí.</p></div>
                }
                else
                {
                    <div class="employee-attachment-list">
                        @foreach (var item in Model.File.Vacations)
                        {
                            <a asp-page="Attachment" asp-route-id="@employee.Identification" asp-route-kind="vacation" asp-route-number="@item.Number"><span>Vacación</span><strong>Movimiento @item.Number</strong></a>
                        }
                        @foreach (var item in Model.File.Disabilities)
                        {
                            <a asp-page="Attachment" asp-route-id="@employee.Identification" asp-route-kind="disability" asp-route-number="@item.Number"><span>Incapacidad</span><strong>Movimiento @item.Number</strong></a>
                        }
                        @foreach (var item in Model.File.Loans)
                        {
                            <a asp-page="Attachment" asp-route-id="@employee.Identification" asp-route-kind="loan" asp-route-number="@item.Number"><span>Vale o préstamo</span><strong>Movimiento @item.Number</strong></a>
                        }
                    </div>
                }
            </div>

            <!-- Las siguientes áreas permanecen explícitamente parciales o sin migrar. -->
            <div class="tab-pane fade" id="increases-pane" role="tabpanel" aria-labelledby="increases-tab" tabindex="0">
                <h2 class="h4">Aumentos</h2>
                <p>El registro y el historial de aumentos están disponibles en el mantenimiento parcial de compensación.</p>
                <a asp-page="Compensation" asp-route-id="@employee.Identification" class="btn btn-primary">Abrir aumentos</a>
            </div>

            <div class="tab-pane fade" id="payroll-pane" role="tabpanel" aria-labelledby="payroll-tab" tabindex="0">
                <div class="employee-empty-state"><strong>Historial de planillas pendiente</strong><p>Aún falta la consulta contextual y los promedios del empleado.</p></div>
            </div>

            <div class="tab-pane fade" id="extra-days-pane" role="tabpanel" aria-labelledby="extra-days-tab" tabindex="0">
                <div class="employee-empty-state"><strong>Días adicionales pendientes</strong><p>El ciclo de registro y cálculo de esta pestaña todavía no está migrado.</p></div>
            </div>

            <div class="tab-pane fade" id="settlement-pane" role="tabpanel" aria-labelledby="settlement-tab" tabindex="0">
                <div class="employee-empty-state"><strong>Liquidación laboral pendiente</strong><p>El cálculo y cierre del ciclo laboral deben validarse antes de habilitar acciones.</p></div>
            </div>

            <div class="tab-pane fade" id="additionals-pane" role="tabpanel" aria-labelledby="additionals-tab" tabindex="0">
                <h2 class="h4">Adicionales</h2>
                <p>El registro y la consulta parcial de adicionales están disponibles en compensación.</p>
                <a asp-page="Compensation" asp-route-id="@employee.Identification" class="btn btn-primary">Abrir adicionales</a>
            </div>
        </div>
    </section>
</main>
