@page "{id}"
@model Essco.Web.Pages.Employees.DetailModel
<details class="mb-3"><summary>Adjuntos de movimientos</summary>
@foreach (var item in Model.File.Vacations) { <p><a asp-page="Attachment" asp-route-id="@Model.File.Employee.Identification" asp-route-kind="vacation" asp-route-number="@item.Number">Vacación @item.Number</a></p> }
@foreach (var item in Model.File.Disabilities) { <p><a asp-page="Attachment" asp-route-id="@Model.File.Employee.Identification" asp-route-kind="disability" asp-route-number="@item.Number">Incapacidad @item.Number</a></p> }
@foreach (var item in Model.File.Loans) { <p><a asp-page="Attachment" asp-route-id="@Model.File.Employee.Identification" asp-route-kind="loan" asp-route-number="@item.Number">Vale/préstamo @item.Number</a></p> }
</details>
<p><a asp-page="Edit" asp-route-id="@Model.File.Employee.Identification">Editar empleado</a> · <a asp-page="Compensation" asp-route-id="@Model.File.Employee.Identification">Aumentos y adicionales</a> · <a asp-page="Movements" asp-route-id="@Model.File.Employee.Identification">Administrar movimientos</a> · <a asp-page="Background" asp-route-id="@Model.File.Employee.Identification">Formación y experiencia</a></p>
@{ViewData["Title"]="Expediente";}<p><a asp-page="Index">← Empleados</a></p><h1>@Model.File.Employee.Name</h1><p>@Model.File.Employee.Identification · @Model.File.Employee.Position · @Model.File.Employee.Email</p><div class="row"><div class="col"><strong>Salario</strong><br/>@Model.File.Employee.Salary.ToString("N2")</div><div class="col"><strong>Vacaciones ganadas</strong><br/>@Model.File.Employee.VacationEarned</div><div class="col"><strong>Consumidas</strong><br/>@Model.File.Employee.VacationUsed</div><div class="col"><strong>Pendientes</strong><br/>@Model.File.Employee.VacationPending</div></div><h2 class="mt-3">Vacaciones</h2><table class="table table-sm"><tbody>@foreach(var x in Model.File.Vacations){<tr><td>@x.From — @x.To</td><td>@x.Days días</td><td>@x.Comments</td><td>@(x.Annulled?"Anulada":"Activa")</td></tr>}</tbody></table><h2>Incapacidades</h2><table class="table table-sm"><tbody>@foreach(var x in Model.File.Disabilities){<tr><td>@x.From — @x.To</td><td>@x.Days días</td><td>@x.Type / @x.Voucher</td><td>@x.Detail</td></tr>}</tbody></table><h2>Deducciones</h2><table class="table table-sm"><tbody>@foreach(var x in Model.File.Deductions){<tr><td>@x.Category</td><td>@x.Amount.ToString("N2")</td><td>@x.Detail</td><td>@x.FirstFortnightPercentage% / @x.SecondFortnightPercentage%</td></tr>}</tbody></table><h2>Vales y préstamos</h2><table class="table table-sm"><tbody>@foreach(var x in Model.File.Loans){<tr><td>@x.Type</td><td>@x.Amount.ToString("N2")</td><td>Saldo @x.Balance.ToString("N2")</td><td>Cuota @x.FortnightPayment.ToString("N2")</td><td>@x.Detail</td></tr>}</tbody></table>
