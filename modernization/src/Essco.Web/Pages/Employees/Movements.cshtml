@page "{id}"
@model Essco.Web.Pages.Employees.MovementsModel
@{ ViewData["Title"] = "Movimientos del empleado"; }
<p><a asp-page="Detail" asp-route-id="@Model.File.Employee.Identification">← Expediente</a></p>
<h1>Movimientos de @Model.File.Employee.Name</h1>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert alert-info">@Model.StatusMessage</div> }
<div class="row g-4">
 <div class="col-lg-6"><h2>Vacación</h2><form method="post" asp-page-handler="Vacation"><div class="row g-2"><div class="col"><label asp-for="Vacation.From"></label><input asp-for="Vacation.From" class="form-control" type="date" /></div><div class="col"><label asp-for="Vacation.To"></label><input asp-for="Vacation.To" class="form-control" type="date" /></div><div class="col"><label asp-for="Vacation.Days"></label><input asp-for="Vacation.Days" class="form-control" /></div></div><label asp-for="Vacation.Comments"></label><textarea asp-for="Vacation.Comments" class="form-control"></textarea><button class="btn btn-primary mt-2">Registrar</button></form></div>
 <div class="col-lg-6"><h2>Incapacidad</h2><form method="post" asp-page-handler="Disability"><div class="row g-2"><div class="col"><label asp-for="Disability.From"></label><input asp-for="Disability.From" class="form-control" type="date" /></div><div class="col"><label asp-for="Disability.To"></label><input asp-for="Disability.To" class="form-control" type="date" /></div><div class="col"><label asp-for="Disability.Days"></label><input asp-for="Disability.Days" class="form-control" /></div></div><input asp-for="Disability.Type" class="form-control mt-2" placeholder="Tipo" /><input asp-for="Disability.Voucher" class="form-control mt-2" placeholder="Número de boleta" /><textarea asp-for="Disability.Detail" class="form-control mt-2" placeholder="Detalle"></textarea><button class="btn btn-primary mt-2">Registrar</button></form></div>
 <div class="col-lg-6"><h2>Deducción</h2><form method="post" asp-page-handler="Deduction"><input asp-for="Deduction.Date" class="form-control" type="date" /><input asp-for="Deduction.Category" class="form-control mt-2" placeholder="Categoría" /><input asp-for="Deduction.Amount" class="form-control mt-2" placeholder="Monto" /><textarea asp-for="Deduction.Detail" class="form-control mt-2" placeholder="Detalle"></textarea><div class="row g-2 mt-1"><div class="col"><label>Primera quincena %</label><input asp-for="Deduction.FirstPercentage" class="form-control" /></div><div class="col"><label>Segunda quincena %</label><input asp-for="Deduction.SecondPercentage" class="form-control" /></div></div><button class="btn btn-primary mt-2">Registrar</button></form></div>
 <div class="col-lg-6"><h2>Vale o préstamo</h2><form method="post" asp-page-handler="Loan"><input asp-for="Loan.Date" class="form-control" type="date" /><input asp-for="Loan.Type" class="form-control mt-2" placeholder="Tipo" /><input asp-for="Loan.Amount" class="form-control mt-2" placeholder="Monto" /><input asp-for="Loan.FortnightPayment" class="form-control mt-2" placeholder="Cuota quincenal" /><textarea asp-for="Loan.Detail" class="form-control mt-2" placeholder="Detalle"></textarea><button class="btn btn-primary mt-2">Registrar</button></form></div>
</div>
<h2 class="mt-4">Movimientos activos</h2>
<table class="table table-sm"><thead><tr><th>Tipo</th><th>Número</th><th>Detalle</th><th></th></tr></thead><tbody>
@foreach (var x in Model.File.Vacations.Where(x => !x.Annulled)) { <tr><td>Vacación</td><td>@x.Number</td><td>@x.From — @x.To · @x.Days días</td><td><form method="post" asp-page-handler="Annul"><input type="hidden" name="type" value="vacation"/><input type="hidden" name="number" value="@x.Number"/><button class="btn btn-sm btn-outline-danger">Anular</button></form></td></tr> }
@foreach (var x in Model.File.Disabilities.Where(x => !x.Annulled)) { <tr><td>Incapacidad</td><td>@x.Number</td><td>@x.From — @x.To · @x.Detail</td><td><form method="post" asp-page-handler="Annul"><input type="hidden" name="type" value="disability"/><input type="hidden" name="number" value="@x.Number"/><button class="btn btn-sm btn-outline-danger">Anular</button></form></td></tr> }
@foreach (var x in Model.File.Deductions.Where(x => !x.Annulled)) { <tr><td>Deducción</td><td>@x.Number</td><td>@x.Category · @x.Amount.ToString("N2")</td><td><form method="post" asp-page-handler="Annul"><input type="hidden" name="type" value="deduction"/><input type="hidden" name="number" value="@x.Number"/><button class="btn btn-sm btn-outline-danger">Anular</button></form></td></tr> }
@foreach (var x in Model.File.Loans.Where(x => !x.Annulled)) { <tr><td>Vale/préstamo</td><td>@x.Number</td><td>@x.Type · saldo @x.Balance.ToString("N2")</td><td><form method="post" asp-page-handler="Annul"><input type="hidden" name="type" value="loan"/><input type="hidden" name="number" value="@x.Number"/><button class="btn btn-sm btn-outline-danger">Anular</button></form></td></tr> }
</tbody></table>
