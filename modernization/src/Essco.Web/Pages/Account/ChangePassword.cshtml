@page
@model Essco.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    Layout = "_AccountLayout";
}

<section class="account-card" aria-labelledby="password-title">
        <p class="account-kicker">SEGURIDAD DE TU CUENTA</p>
        <h1 id="password-title" class="h3 mb-3">Actualiza tu contraseña</h1>
        <p class="text-secondary">Tu usuario ya fue reconocido. Completa este paso para entrar a los módulos.</p>
        <div class="password-rules" id="password-rules">Usa al menos <strong>12 caracteres</strong>, una mayúscula, una minúscula y un número.</div>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" />
                <label asp-for="Input.CurrentPassword"></label>
                <span asp-validation-for="Input.CurrentPassword" class="text-danger small"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-describedby="password-rules" />
                <label asp-for="Input.NewPassword"></label>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <label asp-for="Input.ConfirmPassword"></label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-3">Guardar contraseña</button>
        </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
