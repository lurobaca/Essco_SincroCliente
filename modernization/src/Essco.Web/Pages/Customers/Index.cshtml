@page
@model Essco.Web.Pages.Customers.IndexModel
@{ ViewData["Title"] = "Clientes"; }
<div class="d-flex justify-content-between align-items-center mb-3">
 <div><h1 class="mb-0">Solicitudes de clientes</h1><span class="text-muted">@Model.Result.Total registro(s)</span></div>
 <div><a asp-page="AccountStatement" class="btn btn-outline-primary">Estado de cuenta</a> <a asp-page="Edit" class="btn btn-primary">Nueva solicitud</a></div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert alert-info">@Model.StatusMessage</div> }
<div asp-validation-summary="All" class="text-danger"></div>
<form method="get" class="card card-body mb-3">
 <div class="row g-2 align-items-end">
  <div class="col-md-3"><label asp-for="Term" class="form-label">Buscar</label><input asp-for="Term" class="form-control" /></div>
  <div class="col-md-2 form-check mb-2"><input asp-for="ByName" class="form-check-input" /><label asp-for="ByName" class="form-check-label">Por nombre</label></div>
  <div class="col-md-2"><label asp-for="Agent" class="form-label">Agente</label><input asp-for="Agent" class="form-control" /></div>
  <div class="col-md-2"><label asp-for="From" class="form-label">Desde</label><input asp-for="From" class="form-control" type="date" /></div>
  <div class="col-md-2"><label asp-for="To" class="form-label">Hasta</label><input asp-for="To" class="form-control" type="date" /></div>
  <div class="col-md-2"><label asp-for="State" class="form-label">Estado</label><select asp-for="State" class="form-select"><option value="New">Nuevo</option><option value="Close">Cerrar</option><option value="Modified">Modificado</option><option value="Internal">Interno</option></select></div>
  <div class="col-md-2 form-check mb-2"><input asp-for="Approved" class="form-check-input" /><label asp-for="Approved" class="form-check-label">Aprobados</label></div>
  <div class="col-md-2"><button class="btn btn-outline-primary w-100">Filtrar</button></div>
 </div>
</form>
<div class="table-responsive">
 <table class="table table-striped table-hover align-middle">
  <thead><tr><th>Consecutivo</th><th>Código</th><th>Nombre</th><th>Identificación</th><th>Agente</th><th>Fecha</th><th>Estado</th><th></th></tr></thead>
  <tbody>
  @foreach (var item in Model.Result.Items) {
   <tr><td>@item.Sequence</td><td>@item.Code</td><td>@item.Name</td><td>@item.TaxId</td><td>@item.AgentCode</td><td>@item.RequestedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@(item.Approved ? "Aprobado" : "Pendiente")</td>
    <td class="text-nowrap"><a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a> @if (!item.Approved && item.State != Essco.Domain.Customers.CustomerChangeState.Internal) { <form method="post" asp-page-handler="ProcessSap" class="d-inline"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-success" onclick="return confirm('¿Enviar esta solicitud al servicio SAP?')">Procesar SAP</button></form> }</td></tr>
  }
  </tbody>
 </table>
</div>
@if (Model.TotalPages > 1) {
 <nav><ul class="pagination">
  @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++) { <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")"><a class="page-link" asp-route-PageNumber="@pageNumber" asp-route-Term="@Model.Term" asp-route-ByName="@Model.ByName" asp-route-Approved="@Model.Approved" asp-route-State="@Model.State" asp-route-Agent="@Model.Agent" asp-route-From="@Model.From" asp-route-To="@Model.To">@pageNumber</a></li> }
 </ul></nav>
}
