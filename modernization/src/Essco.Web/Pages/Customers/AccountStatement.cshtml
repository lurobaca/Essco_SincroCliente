@page
@model Essco.Web.Pages.Customers.AccountStatementModel
@{ViewData["Title"]="Estado de cuenta";}
<h1>Estado de cuenta</h1><p class="text-muted">Comprobantes electrónicos internos</p>
<form method="get" class="card card-body mb-3"><div class="row g-2 align-items-end"><div class="col-md-3"><label asp-for="From" class="form-label">Desde</label><input asp-for="From" type="date" class="form-control"/></div><div class="col-md-3"><label asp-for="To" class="form-label">Hasta</label><input asp-for="To" type="date" class="form-control"/></div><div class="col-md-3"><label asp-for="Status" class="form-label">Estado</label><select asp-for="Status" class="form-select"><option value="All">Todos</option><option value="Paid">Cancelados</option><option value="Pending">Pendientes</option></select></div><div class="col-md-3"><button class="btn btn-primary w-100">Consultar</button></div></div></form>
<div asp-validation-summary="All" class="text-danger"></div>
<div class="row mb-3"><div class="col-md-3"><div class="card card-body"><small>Documentos</small><strong>@Model.Items.Count</strong></div></div><div class="col-md-3"><div class="card card-body"><small>Total</small><strong>@Model.Total.ToString("N2")</strong></div></div><div class="col-md-3"><div class="card card-body"><small>Saldo</small><strong>@Model.Balance.ToString("N2")</strong></div></div></div>
<div class="table-responsive"><table class="table table-striped table-sm"><thead><tr><th>Tipo</th><th>Número</th><th>Fecha</th><th>Cliente</th><th>Moneda</th><th class="text-end">Subtotal</th><th class="text-end">Impuesto</th><th class="text-end">Total</th><th class="text-end">Saldo</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.DocumentType</td><td>@item.DocumentNumber</td><td>@item.DocumentDate.ToString("dd/MM/yyyy")</td><td>@item.CustomerName</td><td>@item.Currency</td><td class="text-end">@item.Subtotal.ToString("N2")</td><td class="text-end">@item.Tax.ToString("N2")</td><td class="text-end">@item.Total.ToString("N2")</td><td class="text-end">@item.Balance.ToString("N2")</td></tr>}</tbody></table></div>
