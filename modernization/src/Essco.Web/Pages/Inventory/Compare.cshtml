@page "{id:int}"
@model Essco.Web.Pages.Inventory.CompareModel
@{ ViewData["Title"] = "Comparación de conteos"; }
<h1>Comparación de conteos</h1>
@if (Model.StatusMessage is not null) { <p class="alert alert-info">@Model.StatusMessage</p> }
<p>Vista previa de diferencias. Las cantidades ausentes o duplicadas requieren revisión. Esta consulta no genera un nuevo conteo.</p>
<div asp-validation-summary="All" class="text-danger"></div>
<form method="get" class="row g-2">
    <div class="col"><label asp-for="Group">Grupo</label><input asp-for="Group" class="form-control" required /></div>
    <div class="col"><label asp-for="First">Primer conteo</label><input asp-for="First" class="form-control" /></div>
    <div class="col"><label asp-for="Second">Segundo conteo</label><input asp-for="Second" class="form-control" /></div>
    <div class="col"><label asp-for="Threshold">Umbral monetario</label><input asp-for="Threshold" class="form-control" /></div>
    <div class="col-auto"><button class="btn btn-primary">Comparar</button></div>
</form>
@if (Model.First == 1 && Model.Second == 2 && Model.Lines.Count > 0 && Model.Lines.All(x => !x.Incomplete))
{
    <form method="post" asp-page-handler="Cross" class="mt-3">
        <input asp-for="Group" type="hidden" /><input asp-for="First" type="hidden" />
        <input asp-for="Second" type="hidden" /><input asp-for="Threshold" type="hidden" />
        <button class="btn btn-warning">Cruzar conteos 1 y 2 y generar conteo 3</button>
    </form>
}
<table class="table mt-3">
<thead><tr><th>Artículo</th><th>Primero</th><th>Segundo</th><th>Diferencia</th><th>Importe</th><th>Revisión</th></tr></thead>
<tbody>@foreach (var line in Model.Lines)
{
    <tr><td>@line.Code · @line.Description</td><td>@line.First</td><td>@line.Second</td><td>@line.Difference</td><td>@line.DifferenceAmount?.ToString("N2")</td><td>@(line.Incomplete ? "Datos incompletos o duplicados" : line.RequiresRecount(Model.Threshold) ? "Recontar" : "Dentro del umbral")</td></tr>
}</tbody></table>
