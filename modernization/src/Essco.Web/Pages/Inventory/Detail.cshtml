@page "{id:int}"
@model Essco.Web.Pages.Inventory.DetailModel
<p><a asp-page="Compare" asp-route-id="@RouteData.Values["id"]">Comparar conteos</a></p>
<p><a asp-page="Groups" asp-route-id="@Model.Inventory.Id">Administrar grupos y proveedores</a></p>
@{ViewData["Title"]="Inventario";}<p><a asp-page="Index">← Inventarios</a></p><h1>@Model.Inventory.Id — @Model.Inventory.Title</h1>@if(Model.StatusMessage is not null){<div class="alert alert-info">@Model.StatusMessage</div>}<form method="get" class="row g-2 mb-3"><div class="col"><input asp-for="Group" placeholder="Filtrar grupo" class="form-control"/></div><div class="col-auto"><button class="btn btn-primary">Filtrar conteos</button></div></form><h2>Conteos</h2><table class="table"><thead><tr><th>Grupo</th><th>Conteo</th><th>Artículo</th><th>Cantidad</th><th></th></tr></thead><tbody>@foreach(var x in Model.Counts){<tr><td>@x.Group</td><td>@x.Number</td><td>@x.ItemCode - @x.Description</td><td>@x.Quantity</td><td>@if(!Model.Inventory.Closed){<form method="post" asp-page-handler="Count" class="d-flex gap-1"><input type="hidden" name="Input.Group" value="@x.Group"/><input type="hidden" name="Input.Number" value="@x.Number"/><input type="hidden" name="Input.ItemCode" value="@x.ItemCode"/><input name="Input.Quantity" value="@x.Quantity" class="form-control form-control-sm"/><button class="btn btn-sm btn-outline-primary">Guardar</button></form>}</td></tr>}</tbody></table><h2>Resultado</h2><table class="table"><thead><tr><th>Artículo</th><th>Sistema</th><th>Conteo final</th><th>Diferencia</th><th>Monto</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Code - @x.Description</td><td>@x.SystemStock</td><td>@x.Counted</td><td>@x.Difference</td><td>@x.DifferenceAmount.ToString("N2")</td></tr>}</tbody></table>@if(!Model.Inventory.Closed){<form method="post" asp-page-handler="Close" class="card card-body"><h3>Cerrar inventario</h3><div class="row g-2"><div class="col"><input name="entries" type="number" step="0.01" placeholder="Entradas" class="form-control"/></div><div class="col"><input name="exits" type="number" step="0.01" placeholder="Salidas" class="form-control"/></div><div class="col"><button class="btn btn-danger">Cerrar definitivamente</button></div></div></form>}
