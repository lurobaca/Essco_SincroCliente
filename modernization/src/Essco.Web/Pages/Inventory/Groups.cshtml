@page "{id:int}"
@model Essco.Web.Pages.Inventory.GroupsModel
@{ViewData["Title"]="Grupos de inventario";}<p><a asp-page="Detail" asp-route-id="@Model.Inventory.Id">← Inventario</a></p><h1>Grupos del inventario @Model.Inventory.Id</h1>@if(Model.StatusMessage is not null){<div class="alert alert-info">@Model.StatusMessage</div>}@if(!Model.Inventory.Closed){<form method="post" asp-page-handler="Save" class="card card-body mb-3"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-2"><div class="col"><input asp-for="Input.Code" placeholder="Grupo" class="form-control"/></div><div class="col"><input asp-for="Input.Responsible" placeholder="Responsable" class="form-control"/></div><div class="col"><input asp-for="Input.Companion" placeholder="Acompañante" class="form-control"/></div><div class="col"><input asp-for="Input.SupplierCode" placeholder="Proveedor" class="form-control"/></div><div class="col"><input asp-for="Input.SupplierName" placeholder="Nombre proveedor" class="form-control"/></div><div class="col-auto"><button class="btn btn-primary">Agregar</button></div></div></form>}<table class="table"><thead><tr><th>Grupo</th><th>Responsable</th><th>Acompañante</th><th>Proveedor</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Code</td><td>@x.Responsible</td><td>@x.Companion</td><td>@x.SupplierCode - @x.SupplierName</td><td>@if(!Model.Inventory.Closed){<form method="post" asp-page-handler="Delete"><input type="hidden" name="code" value="@x.Code"/><input type="hidden" name="supplier" value="@x.SupplierCode"/><button class="btn btn-sm btn-outline-danger">Eliminar</button></form>}</td></tr>}</tbody></table>
