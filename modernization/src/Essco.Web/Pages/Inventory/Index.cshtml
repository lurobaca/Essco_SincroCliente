@page
@model Essco.Web.Pages.Inventory.IndexModel
@if(Model.StatusMessage is not null){<div class="alert alert-info">@Model.StatusMessage</div>}<form method="post" asp-page-handler="Create" class="card card-body mb-3"><h2>Nuevo inventario</h2><div class="row g-2"><div class="col"><input asp-for="Input.Title" placeholder="Título" class="form-control"/></div><div class="col"><input asp-for="Input.Comments" placeholder="Comentarios" class="form-control"/></div><div class="col-auto"><button class="btn btn-primary">Crear desde Inve_Conteo</button></div></div></form>
@{ViewData["Title"]="Inventarios";}<h1>Inventarios físicos</h1><table class="table table-striped"><thead><tr><th>Número</th><th>Fecha</th><th>Título</th><th>Estado</th><th>Inicial</th><th>Final</th><th>Diferencias</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><a asp-page="Detail" asp-route-id="@x.Id">@x.Id</a></td><td>@x.Date</td><td>@x.Title</td><td>@(x.Closed?"Cerrado":"Abierto")</td><td>@x.InitialValue.ToString("N2")</td><td>@x.FinalValue.ToString("N2")</td><td>@x.Differences.ToString("N2")</td></tr>}</tbody></table>
