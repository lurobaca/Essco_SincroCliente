@page
@model Essco.Web.Pages.IndexModel
@{
    ViewData["Title"] = User.Identity?.IsAuthenticated == true ? "Inicio" : "Acceso";
}
@if (User.Identity?.IsAuthenticated == true)
{
    <section class="erp-home" aria-label="Inicio de Syncro Cliente">
        <span>ESSCO</span>
    </section>
}
else
{
    <section class="public-access">
        <p class="eyebrow">ESSCO · GESTIÓN WEB</p>
        <h1>Syncro Cliente</h1>
        <p>Inicia sesión para acceder a las funciones autorizadas del sistema.</p>
        <a asp-page="/Account/Login" class="btn btn-primary">Iniciar sesión</a>
    </section>
}
