<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ESSCO</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Essco.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/essco-brand.css" asp-append-version="true" />
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "erp-authenticated" : "")">
    <header class="erp-header">
        <div class="erp-header__inner">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="erp-menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#erpSidebar"
                        aria-controls="erpSidebar" aria-label="Abrir menú general" title="Abrir menú">
                    <span aria-hidden="true"></span>
                </button>
                <a class="essco-wordmark" asp-page="/Index"><span class="essco-name">ESSCO</span><span class="essco-fullname">Easy Software Solution Company</span></a>
                <div class="erp-account">
                    <span>@User.FindFirst("display_name")?.Value</span>
                    <form method="post" asp-page="/Account/Logout"><button type="submit" class="btn btn-outline-secondary btn-sm">Cerrar sesión</button></form>
                </div>
            }
            else
            {
                <a class="essco-wordmark" asp-page="/Index"><span class="essco-name">ESSCO</span><span class="essco-fullname">Easy Software Solution Company</span></a>
                <a class="btn btn-primary" asp-page="/Account/Login">Iniciar sesión</a>
            }
        </div>
    </header>
    <div class="erp-shell">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="offcanvas offcanvas-start erp-sidebar" tabindex="-1" id="erpSidebar" aria-labelledby="erpSidebarLabel">
                <div class="offcanvas-header">
                    <div>
                        <strong class="erp-sidebar__brand" id="erpSidebarLabel">ESSCO</strong>
                        <span class="erp-sidebar__product">Syncro Cliente</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar menú"></button>
                </div>
                <div class="offcanvas-body">@await Component.InvokeAsync("ErpNavigation")</div>
            </aside>
        }
        <div class="erp-page">
            <main role="main">@RenderBody()</main>
            <footer class="erp-footer">&copy; 2026 ESSCO | Easy Software Solution Company · Un mundo con menos clic. · <a asp-page="/Privacy">Privacidad</a></footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
