<!DOCTYPE html>
@using Essco.Application.Security
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Essco</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Essco.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Essco</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacidad</a>
                        </li>
                        @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.Company)).Succeeded)
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Companies/Profile">Empresa</a></li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.Customers)).Succeeded)
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Customers/Index">Clientes</a></li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.Catalogs)).Succeeded)
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Catalogs/Index">Catálogos</a></li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.Cash)).Succeeded)
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Treasury/Deposits">Depósitos</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Treasury/Receipts">Recibos</a></li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.LiquidationDifferences)).Succeeded)
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Liquidations/Index">Liquidaciones</a></li>
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="navbar-text me-3">@User.FindFirst("display_name")?.Value</span>
                        <form method="post" asp-page="/Account/Logout">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Cerrar sesión</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Essco - <a asp-area="" asp-page="/Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
