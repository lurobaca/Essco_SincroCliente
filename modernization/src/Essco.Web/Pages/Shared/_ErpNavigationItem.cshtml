@model Essco.Application.Security.NavigationOption
@using Essco.Application.Security
@{
    var route = Model.Page?.EndsWith("/Index", StringComparison.Ordinal) == true ? Model.Page[..^6] : Model.Page;
    var current = route is not null && Context.Request.Path.StartsWithSegments(route, StringComparison.OrdinalIgnoreCase);
}
@if (Model.IsNavigable)
{
    <a class="erp-nav-item @(current ? "erp-nav-item--current" : null)" asp-page="@Model.Page"
       aria-current="@(current ? "page" : null)" title="@Model.Icon.Function. Disponible en la Web; paridad funcional parcial">
        <partial name="_NavigationIcon" model="Model.Icon" />
        <span>@Model.Label</span><span class="erp-state-label">Parcial</span>
    </a>
}
else
{
    <span class="erp-nav-item erp-nav-item--disabled" role="link" aria-disabled="true"
          title="@Model.Icon.Function. @(Model.State == NavigationMigrationState.ObsoleteReview ? "Función pendiente de revisión" : "Esta función está pendiente de migración")">
        <partial name="_NavigationIcon" model="Model.Icon" />
        <span>@Model.Label</span>
        <span class="erp-state-label">@(Model.State == NavigationMigrationState.ObsoleteReview ? "Por revisar" : "Pendiente")</span>
        <span class="visually-hidden">@(Model.State == NavigationMigrationState.ObsoleteReview ? "Pendiente de revisión" : "Pendiente de migración")</span>
    </span>
}
