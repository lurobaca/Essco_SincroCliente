@page
@model Essco.Web.Pages.Catalogs.ReturnReasonsModel
@{ViewData["Title"]="Motivos de devolución";}
<h1>Motivos de devolución</h1>
@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="alert alert-info">@Model.StatusMessage</div>}
<div class="row g-4"><div class="col-md-5"><form method="post" asp-page-handler="Save" class="card card-body"><input asp-for="Input.Code" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Input.Description" class="form-label"></label><input asp-for="Input.Description" class="form-control mb-2"/><label asp-for="Input.WarehouseCode" class="form-label"></label>@if(Model.Warehouses.Count>0){<select asp-for="Input.WarehouseCode" asp-items="Model.Warehouses" class="form-select"><option value="">Seleccione</option></select>}else{<input asp-for="Input.WarehouseCode" class="form-control"/><small class="text-muted">Configure la base de compañía SAP para cargar bodegas.</small>}<div class="mt-3"><button class="btn btn-primary">Guardar</button> <a class="btn btn-outline-secondary">Nuevo</a></div></form></div><div class="col-md-7"><table class="table table-striped"><thead><tr><th>Descripción</th><th>Bodega</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Description</td><td>@item.WarehouseCode</td><td class="text-nowrap"><a asp-route-code="@item.Code" class="btn btn-sm btn-outline-secondary">Editar</a> <form method="post" asp-page-handler="Delete" class="d-inline"><input type="hidden" name="code" value="@item.Code"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar este motivo?')">Eliminar</button></form></td></tr>}</tbody></table></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
