@page
@model Essco.Web.Pages.Catalogs.WarehousesModel
@{ ViewData["Title"] = "Bodegas"; }
<div class="d-flex justify-content-between"><h1>Bodegas</h1><a asp-page="Index" class="btn btn-outline-secondary align-self-start">Catálogos</a></div>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert alert-info">@Model.StatusMessage</div> }
<div class="row g-4">
    <div class="col-lg-5"><form method="post" asp-page-handler="Save" class="card card-body">
        <input asp-for="Input.IsNew" type="hidden" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <label asp-for="Input.Id" class="form-label"></label><input asp-for="Input.Id" class="form-control" readonly />
        <label asp-for="Input.Name" class="form-label mt-2"></label><input asp-for="Input.Name" class="form-control" />
        <label asp-for="Input.Location" class="form-label mt-2"></label><input asp-for="Input.Location" class="form-control" />
        <div class="row"><div class="col"><label asp-for="Input.Racks" class="form-label mt-2"></label><input asp-for="Input.Racks" class="form-control" /></div><div class="col"><label asp-for="Input.Columns" class="form-label mt-2"></label><input asp-for="Input.Columns" class="form-control" /></div></div>
        <div class="form-check mt-3"><input asp-for="Input.IsDefault" class="form-check-input" /><label asp-for="Input.IsDefault" class="form-check-label"></label></div>
        <div class="mt-3"><button class="btn btn-primary">Guardar</button> <a class="btn btn-outline-secondary">Nueva</a></div>
    </form></div>
    <div class="col-lg-7"><table class="table table-striped"><thead><tr><th>ID</th><th>Nombre</th><th>Ubicación</th><th>Geometría</th><th></th></tr></thead><tbody>
    @foreach (var item in Model.Items) { <tr><td>@item.Id</td><td>@item.Name @if(item.IsDefault){<span class="badge text-bg-primary">Predeterminada</span>}</td><td>@item.Location</td><td>@item.Racks × @item.Columns</td><td><a asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a> <form method="post" asp-page-handler="Delete" class="d-inline"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar esta bodega?')">Eliminar</button></form></td></tr> }
    </tbody></table></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
