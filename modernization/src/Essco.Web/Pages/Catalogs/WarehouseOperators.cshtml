@page
@model Essco.Web.Pages.Catalogs.WarehouseOperatorsModel
@{ ViewData["Title"] = "Bodegueros"; }
<div class="d-flex justify-content-between"><h1>Bodegueros</h1><a asp-page="Index" class="btn btn-outline-secondary align-self-start">Catálogos</a></div>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert alert-info">@Model.StatusMessage</div> }
<form method="post" asp-page-handler="Save" class="card card-body mb-4">
    <input asp-for="Input.IsNew" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3"><div class="col-md-2"><label asp-for="Input.Code" class="form-label"></label>@if(Model.Input.IsNew){<input asp-for="Input.Code" class="form-control" />}else{<input asp-for="Input.Code" class="form-control" readonly />}</div><div class="col-md-5"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control" /></div><div class="col-md-2"><label asp-for="Input.Phone" class="form-label"></label><input asp-for="Input.Phone" class="form-control" /></div><div class="col-md-3"><label asp-for="Input.Identification" class="form-label"></label><input asp-for="Input.Identification" class="form-control" /></div></div>
    <div class="row g-3 mt-1"><div class="col-md-3"><label asp-for="Input.Email" class="form-label"></label><input asp-for="Input.Email" class="form-control" /></div><div class="col-md-3"><label asp-for="Input.Position" class="form-label"></label><input asp-for="Input.Position" class="form-control" /></div><div class="col-md-3"><label asp-for="Input.Username" class="form-label"></label><input asp-for="Input.Username" class="form-control" /></div><div class="col-md-3"><label asp-for="Input.NewPassword" class="form-label"></label><input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" /><small class="text-muted">En edición, déjela vacía para conservarla.</small></div></div>
    <div class="row g-3 mt-1"><div class="col-md-3"><label asp-for="Input.LoadSequence" class="form-label"></label><input asp-for="Input.LoadSequence" class="form-control" /></div><div class="col-md-3"><label asp-for="Input.ReturnSequence" class="form-label"></label><input asp-for="Input.ReturnSequence" class="form-control" /></div><div class="col-md-6"><label asp-for="Input.FtpPath" class="form-label"></label><input asp-for="Input.FtpPath" class="form-control" /></div></div>
    <fieldset class="mt-3"><legend class="h6">Sectores autorizados</legend><div class="d-flex flex-wrap gap-3">@for (var sector = 1; sector <= 20; sector++) { var selected = Model.Input.Sectors.Contains(sector); <label class="form-check"><input class="form-check-input" type="checkbox" name="Input.Sectors" value="@sector" checked="@selected" /> Sector @sector</label> }</div></fieldset>
    <div class="mt-3"><button class="btn btn-primary">Guardar</button> <a class="btn btn-outline-secondary">Nuevo</a></div>
</form>
<table class="table table-striped"><thead><tr><th>Código</th><th>Nombre</th><th>Usuario</th><th>Puesto</th><th>Sectores</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Code</td><td>@item.Name</td><td>@item.Username</td><td>@item.Position</td><td>@string.Join(", ", item.Sectors)</td><td><a asp-route-code="@item.Code" class="btn btn-sm btn-outline-secondary">Editar</a> <form method="post" asp-page-handler="Delete" class="d-inline"><input type="hidden" name="code" value="@item.Code"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar este bodeguero?')">Eliminar</button></form></td></tr>}</tbody></table>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
