@page
@model Essco.Web.Pages.Catalogs.SalesAgentsModel
@{ ViewData["Title"] = "Agentes"; }
<div class="d-flex justify-content-between"><h1>Agentes</h1><a asp-page="Index" class="btn btn-outline-secondary align-self-start">Catálogos</a></div>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert alert-info">@Model.StatusMessage</div> }
<form method="get" class="row g-2 mb-3"><div class="col-auto"><select asp-for="PositionFilter" class="form-select"><option value="">Todos los puestos</option>@foreach(var position in SalesAgentsModel.Positions){<option value="@position">@position</option>}</select></div><div class="col-auto"><button class="btn btn-outline-primary">Filtrar</button></div></form>
<form method="post" asp-page-handler="Save" class="card card-body mb-4"><input asp-for="Input.IsNew" type="hidden"/><input asp-for="PositionFilter" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div>
<div class="row g-3"><div class="col-md-2"><label asp-for="Input.Code" class="form-label"></label>@if(Model.Input.IsNew){<input asp-for="Input.Code" class="form-control"/>}else{<input asp-for="Input.Code" class="form-control" readonly/>}</div><div class="col-md-4"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control"/></div><div class="col-md-2"><label asp-for="Input.Identification" class="form-label"></label><input asp-for="Input.Identification" class="form-control"/></div><div class="col-md-2"><label asp-for="Input.Phone" class="form-label"></label><input asp-for="Input.Phone" class="form-control"/></div><div class="col-md-2"><label asp-for="Input.Position" class="form-label"></label><select asp-for="Input.Position" class="form-select">@foreach(var position in SalesAgentsModel.Positions){<option value="@position">@position</option>}</select></div></div>
<div class="row g-3 mt-1"><div class="col-md-3"><label asp-for="Input.Email" class="form-label"></label><input asp-for="Input.Email" class="form-control"/></div><div class="col-md-6"><label asp-for="Input.FtpPath" class="form-label"></label><input asp-for="Input.FtpPath" class="form-control"/></div><div class="col-md-3"><label asp-for="Input.Group" class="form-label"></label><input asp-for="Input.Group" class="form-control"/></div></div>
<fieldset class="mt-3"><legend class="h6">Consecutivos</legend><div class="row g-3">
<div class="col-md"><label asp-for="Input.OrderSequence" class="form-label"></label><input asp-for="Input.OrderSequence" class="form-control"/></div><div class="col-md"><label asp-for="Input.PaymentSequence" class="form-label"></label><input asp-for="Input.PaymentSequence" class="form-control"/></div><div class="col-md"><label asp-for="Input.DepositSequence" class="form-label"></label><input asp-for="Input.DepositSequence" class="form-control"/></div><div class="col-md"><label asp-for="Input.ExpenseSequence" class="form-label"></label><input asp-for="Input.ExpenseSequence" class="form-control"/></div><div class="col-md"><label asp-for="Input.NoVisitSequence" class="form-label"></label><input asp-for="Input.NoVisitSequence" class="form-control"/></div><div class="col-md"><label asp-for="Input.ReturnSequence" class="form-label"></label><input asp-for="Input.ReturnSequence" class="form-control"/></div><div class="col-md"><label asp-for="Input.NewCustomerSequence" class="form-label"></label><input asp-for="Input.NewCustomerSequence" class="form-control"/></div>
</div></fieldset>
<div class="mt-3"><button class="btn btn-primary">Guardar</button> <a asp-route-PositionFilter="@Model.PositionFilter" class="btn btn-outline-secondary">Nuevo</a></div></form>
<table class="table table-striped"><thead><tr><th>Código</th><th>Nombre</th><th>Puesto</th><th>Teléfono</th><th>Grupo</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Code</td><td>@item.Name</td><td>@item.Position</td><td>@item.Phone</td><td>@item.Group</td><td><a asp-route-code="@item.Code" asp-route-PositionFilter="@Model.PositionFilter" class="btn btn-sm btn-outline-secondary">Editar</a> <form method="post" asp-page-handler="Delete" class="d-inline"><input type="hidden" name="code" value="@item.Code"/><input type="hidden" name="PositionFilter" value="@Model.PositionFilter"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar este agente?')">Eliminar</button></form></td></tr>}</tbody></table>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
