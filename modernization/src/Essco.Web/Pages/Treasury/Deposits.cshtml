@page
@model Essco.Web.Pages.Treasury.DepositsModel
@{ ViewData["Title"] = "Depósitos"; }
<h1>Depósitos</h1>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert alert-info">@Model.StatusMessage</div> }
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col"><label asp-for="Filter.From" class="form-label"></label><input asp-for="Filter.From" class="form-control" /></div><div class="col"><label asp-for="Filter.To" class="form-label"></label><input asp-for="Filter.To" class="form-control" /></div><div class="col"><label asp-for="Filter.Employee" class="form-label"></label><input asp-for="Filter.Employee" class="form-control" /></div><div class="col"><label asp-for="Filter.Number" class="form-label"></label><input asp-for="Filter.Number" class="form-control" /></div><div class="col"><label asp-for="Filter.Consecutive" class="form-label"></label><input asp-for="Filter.Consecutive" class="form-control" /></div><div class="col"><label asp-for="Filter.Type" class="form-label"></label><select asp-for="Filter.Type" class="form-select"><option value="">Todos</option>@foreach(var type in DepositsModel.Types){<option value="@type">@type</option>}</select></div><div class="col"><label asp-for="Filter.Uploaded" class="form-label"></label><select asp-for="Filter.Uploaded" class="form-select"><option value="">Todos</option><option value="false">No</option><option value="true">Sí</option></select></div></div><div class="mt-2"><label class="form-check"><input asp-for="Filter.IncludeAnnulled" class="form-check-input"/> Incluir anulados</label><button class="btn btn-outline-primary">Buscar</button> <a class="btn btn-outline-secondary">Limpiar</a></div></form>
<form method="post" asp-page-handler="Save" class="card card-body mb-4"><input asp-for="Input.IsNew" type="hidden"/><input asp-for="Input.Consecutive" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div>@if(!Model.Input.IsNew){<p><strong>Consecutivo:</strong> @Model.Input.Consecutive</p>}<div class="row g-3"><div class="col-md-3"><label asp-for="Input.Number" class="form-label"></label><input asp-for="Input.Number" class="form-control"/></div><div class="col-md-3"><label asp-for="Input.Bank" class="form-label"></label><input asp-for="Input.Bank" class="form-control" list="bank-list"/><datalist id="bank-list">@foreach(var bank in Model.Banks){<option value="@bank"></option>}</datalist></div><div class="col-md-2"><label asp-for="Input.Amount" class="form-label"></label><input asp-for="Input.Amount" class="form-control"/></div><div class="col-md-2"><label asp-for="Input.Date" class="form-label"></label><input asp-for="Input.Date" class="form-control"/></div><div class="col-md-2"><label asp-for="Input.AccountingDate" class="form-label"></label><input asp-for="Input.AccountingDate" class="form-control"/></div></div><div class="row g-3 mt-1"><div class="col-md-2"><label asp-for="Input.EmployeeCode" class="form-label"></label><input asp-for="Input.EmployeeCode" class="form-control"/></div><div class="col-md-2"><label asp-for="Input.LiquidationType" class="form-label"></label><select asp-for="Input.LiquidationType" class="form-select">@foreach(var type in DepositsModel.Types){<option value="@type">@type</option>}</select></div><div class="col-md-2"><label asp-for="Input.LiquidationNumber" class="form-label"></label><input asp-for="Input.LiquidationNumber" class="form-control"/></div><div class="col-md-5"><label asp-for="Input.Notes" class="form-label"></label><input asp-for="Input.Notes" class="form-control"/></div><div class="col-md-1"><label class="form-label">Estado</label><label class="form-check"><input asp-for="Input.IsUploaded" class="form-check-input"/> Subido</label></div></div><div class="mt-3"><button class="btn btn-primary">Guardar</button> <a class="btn btn-outline-secondary">Nuevo</a></div></form>
<table class="table table-striped"><thead><tr><th>Consecutivo</th><th>Número</th><th>Fecha</th><th>Banco</th><th class="text-end">Monto</th><th>Empleado</th><th>Liquidación</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr class="@(item.IsAnnulled?"table-danger":"")"><td>@item.Consecutive</td><td>@item.Number</td><td>@item.Date</td><td>@item.Bank</td><td class="text-end">@item.Amount.ToString("N2")</td><td>@item.EmployeeCode</td><td>@item.LiquidationType @item.LiquidationNumber</td><td>@(item.IsAnnulled?"Anulado":item.IsUploaded?"Subido":"Pendiente")</td><td><a asp-route-consecutive="@item.Consecutive" class="btn btn-sm btn-outline-secondary">Editar</a>@if(!item.IsAnnulled){<form method="post" asp-page-handler="Annul" class="d-inline"><input type="hidden" name="consecutive" value="@item.Consecutive"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Anular este depósito? No podrá volver a editarse.')">Anular</button></form>}</td></tr>}</tbody></table>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
