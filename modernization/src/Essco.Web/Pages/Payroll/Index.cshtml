@page
@model Essco.Web.Pages.Payroll.IndexModel
<p class="text-muted">Para aguinaldo, el sistema valida saldos pendientes y utiliza automáticamente el período legal del 1 de diciembre al 30 de noviembre.</p>
@{ViewData["Title"]="Planillas";}<h1>Planillas</h1>@if(Model.StatusMessage is not null){<div class="alert alert-info">@Model.StatusMessage</div>}<form method="get" class="row g-2 mb-3"><div class="col"><input asp-for="From" type="date" class="form-control"/></div><div class="col"><input asp-for="To" type="date" class="form-control"/></div><div class="col"><input asp-for="Comments" placeholder="Descripción" class="form-control"/></div><div class="col-auto"><button class="btn btn-primary">Buscar</button></div></form><form method="post" asp-page-handler="Create" class="card card-body mb-3"><h2>Nueva planilla</h2><div class="row g-2"><div class="col"><select asp-for="Input.Type" class="form-select"><option value="1">Ordinaria</option><option value="2">Aguinaldo</option></select></div><div class="col"><input asp-for="Input.From" type="date" class="form-control"/></div><div class="col"><input asp-for="Input.To" type="date" class="form-control"/></div><div class="col"><input asp-for="Input.Comments" placeholder="Comentario" class="form-control"/></div><div class="col-auto"><button class="btn btn-success">Crear</button></div></div></form><table class="table table-striped"><thead><tr><th>Número</th><th>Periodo</th><th>Comentario</th><th>Usuario</th><th>Estado</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><a asp-page="Detail" asp-route-number="@x.Number">@x.Number</a></td><td>@x.From — @x.To</td><td>@x.Comments</td><td>@x.CreatedBy</td><td>@(x.IsOpen?"En proceso":"Finalizada/anulada")</td></tr>}</tbody></table>
