@page "{number:int}"
@model Essco.Web.Pages.Payroll.DetailModel
@{ViewData["Title"]="Planilla";}<p><a asp-page="Index">← Planillas</a></p><h1>Planilla @Model.Payroll.Number</h1><p>@Model.Payroll.From — @Model.Payroll.To · @Model.Payroll.Comments</p>@if(Model.StatusMessage is not null){<div class="alert alert-info">@Model.StatusMessage</div>}<table class="table table-sm"><thead><tr><th>Empleado</th><th>Días</th><th>Salario</th><th>CCSS</th><th>Renta</th><th>Otros</th><th>Vales</th><th>Facturas</th><th>Faltante</th><th>Final</th></tr></thead><tbody>@foreach(var x in Model.Payroll.Employees){<tr><td>@x.Identification<br/>@x.Name<br/><small>@x.Position</small></td><td>@x.DaysWorked</td><td>@x.MonthlySalary.ToString("N2")</td><td>@x.SocialSecurity.ToString("N2")</td><td>@x.IncomeTax.ToString("N2")</td><td>@x.OtherDeductions.ToString("N2")</td><td>@x.Loans.ToString("N2")</td><td>@x.Invoices.ToString("N2")</td><td>@x.LiquidationShortage.ToString("N2")</td><td>@x.FinalSalary.ToString("N2")</td></tr>}</tbody><tfoot><tr><th colspan="9">Total</th><th>@Model.Payroll.Total.ToString("N2")</th></tr></tfoot></table>@if(Model.Payroll.IsOpen){<form method="post" asp-page-handler="Finalize" class="d-inline"><button class="btn btn-success">Finalizar</button></form><form method="post" asp-page-handler="Cancel" class="d-inline"><button class="btn btn-outline-danger">Anular</button></form>}
