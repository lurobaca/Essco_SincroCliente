@page
@model Essco.Portal.Pages.Portal.IndexModel
@{ViewData["Title"]="Mi portal";}
<section class="section">
<p class="eyebrow">PORTAL DEL CLIENTE</p><h1>Hola, @User.Identity?.Name</h1><p class="lead">Administra las herramientas y servicios de tu organización desde un solo lugar.</p>
@if(Model.Selected is null) { <p class="notice">Tu cuenta todavía no pertenece a una organización activa. Solicita acceso al administrador.</p> }
else {
<form method="get" class="organization-picker"><label for="organization">Organización activa</label><select name="organization" id="organization">
@foreach(var org in Model.Organizations) { <option value="@org.Id" selected="@(org.Id==Model.Selected.Id)">@org.Name</option> }
</select><button class="secondary">Cambiar organización</button></form>
<div class="dashboard-heading"><h2>Mis aplicaciones</h2><span class="badge">@Model.Selected.Role</span></div>
<div class="cards">
@foreach(var application in Model.Applications) {
<article class="card featured"><span class="badge neutral">@(application.Enabled ? "Asignada · Conexión pendiente" : "Pendiente de activación")</span><h3>@application.Name</h3><p>@application.Description</p><p class="notice">El enlace seguro al ERP de esta organización todavía no está conectado. El ERP existente permanece separado.</p></article>
}
@if(Model.Applications.Count==0) { <p>No hay aplicaciones asignadas a esta organización.</p> }
</div>
<div class="portal-modules">
<article class="card"><p class="eyebrow">FACTURACIÓN</p><h3>Facturas y pagos</h3><p>Consulta de cargos, comprobantes y estado de la suscripción.</p><span class="badge neutral">Próxima fase · Sin cobros activos</span></article>
<article class="card"><p class="eyebrow">SOPORTE</p><h3>Casos de soporte</h3><p>Registro, seguimiento y comunicación de incidencias de las aplicaciones.</p><span class="badge neutral">Próxima fase</span></article>
<article class="card"><p class="eyebrow">EQUIPO</p><h3>Usuarios y permisos</h3><p>Alta, activación y permisos del equipo por cada aplicación contratada.</p><span class="badge neutral">Próxima fase</span></article>
<article class="card"><p class="eyebrow">ORGANIZACIÓN</p><h3>@Model.Selected.Name</h3><p>Configuración de la empresa y responsables administrativos.</p><span class="muted">Tu rol actual: @Model.Selected.Role</span></article>
</div>
}
</section>
