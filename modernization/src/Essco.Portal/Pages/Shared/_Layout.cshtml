<!doctype html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="ESSCO desarrolla software e integraciones empresariales para ventas, inventario, facturación y administración." /><title>@ViewData["Title"] · ESSCO</title><link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/essco-brand.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" /></head><body><a class="skip" href="#contenido">Saltar al contenido</a><header class="topbar"><a class="brand essco-wordmark" asp-page="/Index" aria-label="ESSCO, inicio"><span class="essco-name">ESSCO</span><span class="essco-fullname">Easy Software Solution Company</span></a><nav aria-label="Navegación principal"><a href="/#inicio">Inicio</a><a href="/#servicios">Servicios</a><a href="/#aplicaciones">Aplicaciones</a><a href="/#clientes">Portal</a><a href="/#nosotros">Nosotros</a><a href="/#contacto">Contacto</a>@if(User.Identity?.IsAuthenticated == true){<a class="button small" asp-page="/Portal/Index">Mi portal</a><form method="post" asp-page="/Account/Logout"><button class="text-button">Cerrar sesión</button></form>}else{<a class="portal-link" asp-page="/Account/Register">Registrarme</a><a class="button small" asp-page="/Account/Login">Acceso de clientes</a>}</nav></header><main id="contenido" tabindex="-1">@RenderBody()</main><footer><div class="essco-footer-brand"><strong>ESSCO</strong><span>Easy Software Solution Company</span><span>Un mundo con menos clic.</span></div><div class="footer-links"><a href="/#servicios">Servicios</a><a href="/#aplicaciones">Aplicaciones</a><a href="/#contacto">Contacto</a><a asp-page="/Privacy">Privacidad</a></div><span>© @DateTime.Now.Year ESSCO</span></footer></body></html>
